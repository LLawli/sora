#!/usr/bin/env bash
# bin/release — cut a release. Standardized entry point so "release v0.2.0"
# means the same thing in every project (and an agent can run it unassisted):
#
#   bin/release 0.2.0
#   git push origin main v0.2.0     # the tag triggers .github/workflows/release.yml
#
# What it does: bumps the version everywhere it lives, rolls the CHANGELOG's
# Unreleased section into the new version, runs the test suite, commits and
# tags. It never pushes — that last, irreversible step stays yours.
set -euo pipefail

cd "$(dirname "$0")/.."

VERSION="${1:?usage: bin/release X.Y.Z}"
case $VERSION in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) echo "error: version must be X.Y.Z (got '$VERSION')" >&2; exit 1 ;;
esac

if [ -n "$(git status --porcelain)" ]; then
    echo "error: working tree is not clean; commit or stash first" >&2
    exit 1
fi
if git rev-parse "v$VERSION" >/dev/null 2>&1; then
    echo "error: tag v$VERSION already exists" >&2
    exit 1
fi
grep -q "^## \[Unreleased\]" CHANGELOG.md ||
    { echo "error: CHANGELOG.md has no '## [Unreleased]' section" >&2; exit 1; }

echo "==> Bumping version to $VERSION ..."
sed -i "s/^SORA_VERSION=.*/SORA_VERSION=\"$VERSION\"/" bin/sora

echo "==> Rolling CHANGELOG ..."
TODAY=$(date -u +%Y-%m-%d)
awk -v ver="$VERSION" -v today="$TODAY" '
    /^## \[Unreleased\]/ {
        print
        print ""
        print "## [" ver "] - " today
        next
    }
    { print }
' CHANGELOG.md > CHANGELOG.md.tmp && mv CHANGELOG.md.tmp CHANGELOG.md

echo "==> Running the test suite ..."
bash tests/run.sh

echo "==> Committing and tagging ..."
git add bin/sora CHANGELOG.md
git commit -m "release: v$VERSION"
# Always annotated, always with a message. A bare 'git tag' becomes an
# annotated tag under tag.gpgsign=true, and then dies with "no tag message?"
# the moment no editor can be opened — which is every CI job and every agent.
git tag -a -m "sora v$VERSION" "v$VERSION"

echo
echo "Done. Review, then publish with:"
echo "  git push origin main v$VERSION"
