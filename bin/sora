#!/usr/bin/env bash
# sora — run distrobox container commands as if they were native host commands.
#
# Two complementary strategies:
#   * late resolution: a shell command-not-found hook consults a cached
#     command->box index and dispatches into the box. Host precedence is
#     structural: the hook only ever fires after PATH lookup already failed.
#   * anxious export: a real wrapper in PATH for one specific command
#     (delegated to distrobox-export), for scripts/.desktop/cron contexts
#     the late hook cannot reach.
#
# See README.md for the full design rationale.

set -u

SORA_VERSION="0.4.0"

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

SORA_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/sora"
SORA_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/sora"
SORA_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/sora"

BOXES_DIR="$SORA_CONFIG/boxes"
LISTS_DIR="$SORA_CACHE/index.d"
INDEX="$SORA_CACHE/index"
PINS="$SORA_CONFIG/pins"
ANXIOUS_REG="$SORA_CONFIG/anxious.list"
DELEGATE_REG="$SORA_CONFIG/delegate.list"
PROVIDE_REG="$SORA_CONFIG/provide.list"
EXPORT_PATH="$HOME/.local/bin"
HOMES_DIR="$SORA_DATA/homes"

# Where a .desktop entry and its icons have to land to be seen by the host's
# menu. Both are plain XDG locations, NOT under SORA_DATA: the desktop
# environment only scans these, and an entry it cannot see is worthless.
XDG_DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}"
DESKTOP_DIR="$XDG_DATA_ROOT/applications"
ICON_DIR="$XDG_DATA_ROOT/icons"

# Same reasoning for 'sora provide': these are the directories p11-kit and NSS
# scan, so they are where an integration point has to be written. ~/.pki/nssdb
# is not XDG - Chromium hardcodes it.
XDG_CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
PKCS11_MODULES_DIR="$XDG_CONFIG_ROOT/pkcs11/modules"
NSSDB_DIR="$HOME/.pki/nssdb"
# The prefix is what makes the NSS undo something we can prove we own, exactly
# like the 'sora-' on desktop entries and imported icons.
NSS_MODULE_NAME="sora-p11-kit-proxy"

SORA_USER_NAME=$(id -un)
TAB=$(printf '\t')

# Where the shipped shell hooks and merge script live. Two layouts:
#   installed:    PREFIX/bin/sora + PREFIX/share/sora/{shell,libexec}
#   dev checkout: repo/bin/sora   + repo/{shell,libexec}
#
# The UNRESOLVED location is tried first, on purpose: under Homebrew,
# bin/sora is a symlink into a versioned Cellar keg, and following it would
# embed a path that dies on the next upgrade — 'hook install' writes this
# path into rc files, so it must be the stable prefix
# (e.g. /home/linuxbrew/.linuxbrew/share/sora), never the keg. The resolved
# location stays as a fallback for e.g. ~/bin/sora -> checkout symlinks.
resolve_share() {
    local self dir cand root
    self="${BASH_SOURCE[0]:-$0}"
    dir=$(cd "$(dirname "$self")" 2>/dev/null && pwd) || dir=""
    for cand in "$dir" "$(dirname "$(readlink -f "$self")")"; do
        [ -n "$cand" ] || continue
        root=$(dirname "$cand")
        if [ -d "$root/share/sora/shell" ]; then
            printf '%s\n' "$root/share/sora"
            return 0
        fi
        if [ -d "$root/shell" ] && [ -d "$root/libexec" ]; then
            printf '%s\n' "$root"
            return 0
        fi
    done
    printf 'sora: error: cannot locate the sora share directory near %s\n' "$self" >&2
    exit 1
}
SORA_SHARE=$(resolve_share)

# ---------------------------------------------------------------------------
# UI helpers
# ---------------------------------------------------------------------------

info() { printf 'sora: %s\n' "$*"; }
warn() { printf 'sora: warning: %s\n' "$*" >&2; }
die()  { printf 'sora: error: %s\n' "$*" >&2; exit 1; }

confirm() {
    local reply
    printf 'sora: %s [y/N] ' "$1"
    read -r reply
    case $reply in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "'$1' is required but was not found in PATH"
}

# Count entries in a directory without parsing ls(1).
count_files() { # dir
    local n=0 f
    for f in "$1"/*; do
        [ -e "$f" ] && n=$((n + 1))
    done
    printf '%s\n' "$n"
}

container_manager() {
    if command -v podman >/dev/null 2>&1; then
        printf 'podman\n'
    elif command -v docker >/dev/null 2>&1; then
        printf 'docker\n'
    else
        die "neither podman nor docker found; sora needs a container manager"
    fi
}

container_exists() {
    if command -v podman >/dev/null 2>&1; then
        podman container exists "$1" 2>/dev/null && return 0
    fi
    if command -v docker >/dev/null 2>&1; then
        docker container inspect "$1" >/dev/null 2>&1 && return 0
    fi
    return 1
}

# Stricter than container_exists: is it up RIGHT NOW? Live delegation uses
# this so that a Tab never wakes a stopped box. Waking one costs ~3s, which
# would read as a frozen terminal, and the user did not ask to start anything.
container_running() {
    local state
    if command -v podman >/dev/null 2>&1; then
        state=$(podman container inspect "$1" --format '{{.State.Running}}' 2>/dev/null) &&
            [ "$state" = true ] && return 0
    fi
    if command -v docker >/dev/null 2>&1; then
        state=$(docker container inspect "$1" --format '{{.State.Running}}' 2>/dev/null) &&
            [ "$state" = true ] && return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# Tiny flat-TOML helpers (only `key = value` lines; good enough on purpose:
# the same file must also be parseable by awk from the POSIX merge script)
# ---------------------------------------------------------------------------

toml_get() { # file key
    awk -F'=' -v k="$2" '
        /^[ \t]*#/ { next }
        { key = $1; gsub(/[ \t]/, "", key) }
        key == k {
            v = $2
            sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
            gsub(/"/, "", v)
            print v
            exit
        }
    ' "$1"
}

toml_set() { # file key value [raw]
    local f=$1 k=$2 v=$3 raw=${4:-} tmp
    tmp=$(mktemp)
    awk -v k="$k" -v v="$v" -v raw="$raw" -F'=' '
        BEGIN { done = 0 }
        {
            key = $1; gsub(/[ \t]/, "", key)
            if (key == k) {
                if (raw != "") print k " = " v
                else           print k " = \"" v "\""
                done = 1
                next
            }
            print
        }
        END {
            if (!done) {
                if (raw != "") print k " = " v
                else           print k " = \"" v "\""
            }
        }
    ' "$f" > "$tmp" && mv "$tmp" "$f"
}

box_meta() { printf '%s\n' "$BOXES_DIR/$1.toml"; }
box_configured() { [ -f "$(box_meta "$1")" ]; }

require_box() {
    box_configured "$1" || die "box '$1' is not managed by sora (no $(box_meta "$1"))"
}

# ---------------------------------------------------------------------------
# Generated-file templates
#
# Everything below is generated with ABSOLUTE paths embedded at generation
# time. This is deliberate, not lazy: `sudo` inside a container resets $HOME
# to /root, and with `--home` the box's $HOME differs from the host's, so any
# runtime path resolution in these scripts would break. See README pitfalls.
# ---------------------------------------------------------------------------

template_reindex() {
    # Runs INSIDE a box, as the regular user (never root: under distrobox's
    # keep-id userns, container root maps to an unprivileged host subuid that
    # cannot write the user's 0700 ~/.cache).
    cat <<EOF
#!/bin/sh
# sora-reindex — generated by sora $SORA_VERSION. Do not edit.
# Runs INSIDE a box, as the regular user. All paths are embedded at
# generation time: sudo inside the container resets \$HOME, and the box may
# have its own --home, so nothing here may depend on the runtime environment.
CACHE_DIR='$SORA_CACHE'
CONFIG_DIR='$SORA_CONFIG'
DATA_DIR='$SORA_DATA'
MERGE='$SORA_DATA/libexec/sora-merge-index'
EOF
    cat <<'EOF'
BOX="$1"
[ -n "$BOX" ] || { echo "usage: sora-reindex <box>" >&2; exit 64; }

mkdir -p "$CACHE_DIR/index.d"
tmp="$CACHE_DIR/index.d/.$BOX.tmp"

# Enumerate executables from the standard system dirs. A plain glob loop is
# POSIX and fork-free, and works even on busybox-based boxes. /usr/games is
# real: Debian/Ubuntu install sl, cowsay, fortune & friends there.
{
    for d in /usr/local/bin /usr/local/sbin /usr/bin /usr/sbin /bin /sbin \
             /usr/games /usr/local/games /opt/bin; do
        [ -d "$d" ] || continue
        for f in "$d"/*; do
            [ -x "$f" ] && [ ! -d "$f" ] && printf '%s\n' "${f##*/}"
        done
    done
} | sort -u > "$tmp"
mv -f "$tmp" "$CACHE_DIR/index.d/$BOX.list"

# Stamp last_indexed in the box metadata, then rebuild the merged index.
meta="$CONFIG_DIR/boxes/$BOX.toml"
if [ -f "$meta" ]; then
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if grep -q '^last_indexed' "$meta"; then
        sed -i "s/^last_indexed = .*/last_indexed = \"$now\"/" "$meta"
    else
        printf 'last_indexed = "%s"\n' "$now" >> "$meta"
    fi
fi

# Copy this box's own completion scripts out to the host cache, so the host
# shell can complete arguments without entering the container on every Tab.
# Only scripts whose name matches a command this box actually provides are
# copied: the rest is dead weight, and worse, could advertise completion for
# a command the box does not even have.
COMP_TMP="$CACHE_DIR/completions.d/.$BOX.tmp"
COMP_DST="$CACHE_DIR/completions.d/$BOX"
rm -rf "$COMP_TMP"
{
    for kind in bash zsh fish; do
        case $kind in
            bash) dirs='/usr/share/bash-completion/completions /usr/local/share/bash-completion/completions /etc/bash_completion.d' ;;
            zsh)  dirs='/usr/share/zsh/site-functions /usr/share/zsh/vendor-completions /usr/local/share/zsh/site-functions' ;;
            fish) dirs='/usr/share/fish/vendor_completions.d /usr/share/fish/completions' ;;
        esac
        for d in $dirs; do
            [ -d "$d" ] || continue
            for f in "$d"/*; do
                [ -f "$f" ] || continue
                base=${f##*/}
                case $kind in
                    zsh)  cmd=${base#_} ;;
                    fish) cmd=${base%.fish} ;;
                    *)    cmd=$base ;;
                esac
                printf '%s\t%s\t%s\n' "$cmd" "$kind" "$f"
            done
        done
    done
} | awk -F'\t' -v list="$CACHE_DIR/index.d/$BOX.list" '
    BEGIN { while ((getline l < list) > 0) have[l] = 1 }
    ($1 in have) { print }
' | while IFS='	' read -r cmd kind src; do
    mkdir -p "$COMP_TMP/$kind"
    case $kind in
        zsh)  dst="$COMP_TMP/$kind/_$cmd" ;;
        fish) dst="$COMP_TMP/$kind/$cmd.fish" ;;
        *)    dst="$COMP_TMP/$kind/$cmd" ;;
    esac
    # First source dir wins: they are listed most-specific first.
    [ -f "$dst" ] || cp "$src" "$dst" 2>/dev/null || true
done
rm -rf "$COMP_DST"
if [ -d "$COMP_TMP" ]; then
    mv "$COMP_TMP" "$COMP_DST"
fi

[ -x "$MERGE" ] && exec "$MERGE" "$CONFIG_DIR" "$CACHE_DIR" "$DATA_DIR"
exit 0
EOF
}

template_trigger() { # box
    # Installed INSIDE the box at /usr/local/bin/sora-index-refresh and called
    # by the package-manager hook, which runs as root. It must drop back to
    # the real user before touching anything in the host home (pitfall: under
    # keep-id, container root cannot write the user's 0700 ~/.cache).
    local box=$1
    cat <<EOF
#!/bin/sh
# sora-index-refresh — generated by sora $SORA_VERSION for box '$box'.
# Do not edit. Called by the package manager's post-transaction hook (as
# root); drops privileges back to the user and reindexes by writing the
# host's cache DIRECTLY through the bind-mounted home — no host-exec IPC,
# which is fragile in non-interactive contexts.
REINDEX='$SORA_DATA/libexec/sora-reindex'
SORA_USER='$SORA_USER_NAME'
SORA_BOX='$box'
EOF
    cat <<'EOF'
[ -x "$REINDEX" ] || exit 0
if command -v runuser >/dev/null 2>&1; then
    exec runuser -u "$SORA_USER" -- "$REINDEX" "$SORA_BOX"
fi
exec su "$SORA_USER" -s /bin/sh -c "\"$REINDEX\" \"$SORA_BOX\""
EOF
}

template_pm_hook() { # dnf5|apt|pacman
    case $1 in
        dnf5) cat <<'EOF'
# sora: refresh the host command index after every dnf transaction.
# Field format: callback:package_filter:direction:options:command
# An empty package_filter makes the command run exactly once per transaction.
# Requires the 'libdnf5-plugin-actions' package (sora installs it).
post_transaction::::/usr/local/bin/sora-index-refresh
EOF
        ;;
        apt) cat <<'EOF'
// sora: refresh the host command index after every dpkg run.
DPkg::Post-Invoke {"/usr/local/bin/sora-index-refresh || true";};
EOF
        ;;
        pacman) cat <<'EOF'
# sora: refresh the host command index after every pacman transaction.
# This file lives in /etc/pacman.d/hooks and deliberately does NOT contain
# the string "distrobox" in its name: distrobox deletes libalpm hooks
# matching *distrobox* inside its containers.

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = sora: refreshing host command index
When = PostTransaction
Exec = /usr/local/bin/sora-index-refresh
EOF
        ;;
        *) die "unknown package-manager hook type '$1'" ;;
    esac
}

pm_hook_path() { # dnf5|apt|pacman
    case $1 in
        dnf5)   printf '/etc/dnf/libdnf5-plugins/actions.d/sora.actions\n' ;;
        apt)    printf '/etc/apt/apt.conf.d/99-sora-index\n' ;;
        pacman) printf '/etc/pacman.d/hooks/sora-index.hook\n' ;;
        *) die "unknown package-manager hook type '$1'" ;;
    esac
}

template_inbox_install() { # dnf5|apt|pacman
    # Runs as root INSIDE the box. Staged files are copied (as the user) into
    # the container-private /tmp first: root inside a keep-id userns cannot
    # read the host user's 0700 home, so this script may not reference it.
    cat <<'EOF'
#!/bin/sh
# Generated by sora. Runs as root inside a box via 'sudo sh <this file>'.
set -e
STAGE=/tmp/.sora-stage
install -m 0755 "$STAGE/sora-index-refresh" /usr/local/bin/sora-index-refresh
EOF
    case $1 in
        dnf5) cat <<'EOF'
# The actions plugin is not part of the fedora-toolbox image.
if ! rpm -q libdnf5-plugin-actions >/dev/null 2>&1; then
    if command -v dnf5 >/dev/null 2>&1; then
        dnf5 -y install libdnf5-plugin-actions
    else
        dnf -y install libdnf5-plugin-actions
    fi
fi
install -d /etc/dnf/libdnf5-plugins/actions.d
install -m 0644 "$STAGE/pm-hook" /etc/dnf/libdnf5-plugins/actions.d/sora.actions
EOF
        ;;
        apt) cat <<'EOF'
install -d /etc/apt/apt.conf.d
install -m 0644 "$STAGE/pm-hook" /etc/apt/apt.conf.d/99-sora-index
EOF
        ;;
        pacman) cat <<'EOF'
install -d /etc/pacman.d/hooks
install -m 0644 "$STAGE/pm-hook" /etc/pacman.d/hooks/sora-index.hook
EOF
        ;;
        *) die "unknown package-manager hook type '$1'" ;;
    esac
}

template_detect_pm() {
    cat <<'EOF'
#!/bin/sh
# sora-detect-pm — generated by sora. Runs inside a box as the user.
# Detection is by binary presence, never by guessing from the image name.
for pm in dnf5 dnf apt-get pacman zypper apk xbps-install emerge; do
    command -v "$pm" >/dev/null 2>&1 && { printf '%s\n' "$pm"; exit 0; }
done
printf 'unknown\n'
EOF
}

template_which() {
    cat <<'EOF'
#!/bin/sh
# sora-which — generated by sora. Runs inside a box as the user.
command -v -- "$1"
EOF
}

template_desktop_scan() {
    # Runs INSIDE a box, as the user. Prints PATHS ONLY, never file contents:
    # the host copies the files out with `podman cp`, so an icon (binary PNG,
    # NUL bytes and all) never has to survive a round-trip through command
    # substitution, which would truncate it at the first NUL.
    cat <<'EOF'
#!/bin/sh
# sora-desktop-scan — generated by sora. Runs INSIDE a box, as the user.
#   sora-desktop-scan entry <command>    -> path of the app's .desktop, if any
#   sora-desktop-scan icons <icon-name>  -> one icon file path per line
set -u

mode=${1:-}
arg=${2:-}
[ -n "$mode" ] && [ -n "$arg" ] || exit 2

app_dirs="$HOME/.local/share/applications /usr/local/share/applications /usr/share/applications"
icon_roots="$HOME/.local/share/icons /usr/local/share/icons /usr/share/icons"

# First token of Exec=, minus leading env assignments and the directory:
# 'Exec=env MOZ_X=1 /usr/lib/firefox/firefox %u' -> firefox
exec_command() { # desktop-file
    sed -n 's/^Exec=//p' "$1" | head -n1 | tr -s ' ' '\n' | while read -r tok; do
        case $tok in
            '' | env | *=*) continue ;;
            *) printf '%s\n' "${tok##*/}"; break ;;
        esac
    done
}

case $mode in
    entry)
        for d in $app_dirs; do
            if [ -f "$d/$arg.desktop" ]; then
                printf '%s\n' "$d/$arg.desktop"
                exit 0
            fi
        done
        # No entry named after the command: fall back to whichever entry
        # actually launches it. NoDisplay entries are skipped on purpose -
        # they are URL handlers and settings panels, not the app the user means.
        for d in $app_dirs; do
            [ -d "$d" ] || continue
            for f in "$d"/*.desktop; do
                [ -f "$f" ] || continue
                grep -qi '^NoDisplay=true' "$f" && continue
                if [ "$(exec_command "$f")" = "$arg" ]; then
                    printf '%s\n' "$f"
                    exit 0
                fi
            done
        done
        exit 1
        ;;
    icons)
        # An absolute Icon= is already a path; nothing to search for.
        case $arg in
            /*) [ -f "$arg" ] && printf '%s\n' "$arg"; exit 0 ;;
        esac
        found=0
        for root in $icon_roots; do
            [ -d "$root/hicolor" ] || continue
            for f in "$root"/hicolor/*/apps/"$arg".png \
                "$root"/hicolor/*/apps/"$arg".svg \
                "$root"/hicolor/*/apps/"$arg".xpm; do
                [ -f "$f" ] || continue
                printf '%s\n' "$f"
                found=$((found + 1))
            done
        done
        for f in /usr/share/pixmaps/"$arg".png /usr/share/pixmaps/"$arg".svg \
            /usr/share/pixmaps/"$arg".xpm; do
            [ -f "$f" ] || continue
            printf '%s\n' "$f"
            found=$((found + 1))
        done
        [ "$found" -gt 0 ]
        ;;
    *) exit 2 ;;
esac
EOF
}

template_pkcs11() {
    # Runs INSIDE a box, as the user. Exists because of quoting: the modutil
    # module spec is ONE argv element containing spaces, double quotes,
    # parentheses and braces, and distrobox-enter rebuilds and re-splits the
    # command line. Same class of problem that sora-which and sora-desktop-scan
    # were generated to avoid: here every argument that crosses the boundary
    # is a whitespace-free token, and the punctuation is assembled on this side.
    cat <<'EOF'
#!/bin/sh
# sora-pkcs11 — generated by sora. Runs INSIDE a box, as the user.
#   sora-pkcs11 check   <library>                -> ok | no-p11-kit | no-remote | no-lib
#   sora-pkcs11 nss-add <dbdir> <library> <name> -> ok | no-modutil | failed
#   sora-pkcs11 nss-del <dbdir> <name>           -> ok | no-modutil | failed
#
# A PKCS#11 driver can abort the process that loads it (SerproID's
# libneoidp11.so SIGSEGVs unless its own application is authenticated), so
# cores are disabled here rather than filling the machine with dumps.
ulimit -c 0 2>/dev/null || :
set -u

mode=${1:-}
[ -n "$mode" ] || exit 2

case $mode in
    check)
        lib=${2:-}
        [ -n "$lib" ] || exit 2
        command -v p11-kit >/dev/null 2>&1 || { echo no-p11-kit; exit 0; }
        # On some distributions 'p11-kit remote' ships in a separate package
        # (Fedora's p11-kit-server), so having the binary is not enough.
        p11-kit --help 2>&1 | grep -q remote || { echo no-remote; exit 0; }
        [ -e "$lib" ] || { echo no-lib; exit 0; }
        echo ok
        ;;
    nss-add)
        dbdir=${2:-}; lib=${3:-}; name=${4:-}
        [ -n "$dbdir" ] && [ -n "$lib" ] && [ -n "$name" ] || exit 2
        command -v modutil >/dev/null 2>&1 || { echo no-modutil; exit 0; }
        [ -f "$dbdir/pkcs11.txt" ] ||
            modutil -create -dbdir "sql:$dbdir" -force < /dev/null >/dev/null 2>&1
        # -rawadd, never -add: -add LOADS the library to enumerate its slots,
        # and the .so is the HOST's build while this modutil is the box's.
        # -rawadd only writes the stanza, which is all that is wanted.
        # -force and </dev/null because modutil otherwise stops to ask the
        # user to shut down all browsers.
        if modutil -rawadd "library=$lib name=\"$name\" NSS=\"trustOrder=100\"" \
            -dbdir "sql:$dbdir" -force < /dev/null >/dev/null 2>&1; then
            echo ok
        else
            echo failed
        fi
        ;;
    nss-del)
        dbdir=${2:-}; name=${3:-}
        [ -n "$dbdir" ] && [ -n "$name" ] || exit 2
        command -v modutil >/dev/null 2>&1 || { echo no-modutil; exit 0; }
        if modutil -delete "$name" -dbdir "sql:$dbdir" -force < /dev/null >/dev/null 2>&1; then
            echo ok
        else
            echo failed
        fi
        ;;
    *) exit 2 ;;
esac
EOF
}

template_native_messaging() {
    # Runs INSIDE a box, as the user. Prints PATHS ONLY, like sora-desktop-scan
    # and for the same reason: the host copies the file out with 'podman cp',
    # which preserves it exactly, whereas piping it through command
    # substitution would strip the trailing newline and cost the byte-for-byte
    # guarantee the adapter is built on.
    cat <<'EOF'
#!/bin/sh
# sora-native-messaging — generated by sora. Runs INSIDE a box, as the user.
#   sora-native-messaging find <host-name>  -> <family><TAB><path>, one per line
#   sora-native-messaging list              -> <family><TAB><name><TAB><path>
#
# 'list' exists so that a failed 'find' can tell the user what the box DOES
# have, instead of only what it does not.
set -u

mode=${1:-}
[ -n "$mode" ] || exit 2

# A prefix for the SYSTEM directories only, so the test suite can present a
# fake box without depending on what the machine running it happens to have in
# /etc. Empty in real use. Same seam, and same reason, as SORA_SYSROOT on the
# host side. User directories need no prefix: they already hang off $HOME.
R=${SORA_NM_ROOT:-}

# System directories first: a vendor .deb or .rpm installs into these, and the
# box's own ~/.config is usually empty.
chromium_dirs() {
    printf '%s\n' \
        "$R"/etc/opt/chrome/native-messaging-hosts \
        "$R"/etc/opt/edge/native-messaging-hosts \
        "$R"/etc/opt/vivaldi/native-messaging-hosts \
        "$R"/etc/chromium/native-messaging-hosts \
        "$R"/etc/chromium-browser/native-messaging-hosts \
        "$R"/etc/brave/native-messaging-hosts \
        "$R"/etc/opt/brave/native-messaging-hosts \
        "$R"/usr/lib/chromium/NativeMessagingHosts \
        "$R"/usr/lib64/chromium/NativeMessagingHosts \
        "$HOME/.config/chromium/NativeMessagingHosts" \
        "$HOME/.config/google-chrome/NativeMessagingHosts" \
        "$HOME/.config/BraveSoftware/Brave-Browser/NativeMessagingHosts" \
        "$HOME/.config/microsoft-edge/NativeMessagingHosts" \
        "$HOME/.config/vivaldi/NativeMessagingHosts"
}

firefox_dirs() {
    printf '%s\n' \
        "$R"/usr/lib/mozilla/native-messaging-hosts \
        "$R"/usr/lib64/mozilla/native-messaging-hosts \
        "$R"/usr/share/mozilla/native-messaging-hosts \
        "$R"/usr/local/lib/mozilla/native-messaging-hosts \
        "$HOME/.mozilla/native-messaging-hosts"
}

emit() { # family dir name
    f="$3.json"
    [ -f "$2/$f" ] || return 1
    printf '%s\t%s\n' "$1" "$2/$f"
}

case $mode in
    find)
        arg=${2:-}
        [ -n "$arg" ] || exit 2
        hit=0
        for d in $(chromium_dirs); do emit chromium "$d" "$arg" && { hit=1; break; }; done
        for d in $(firefox_dirs);  do emit firefox  "$d" "$arg" && { hit=1; break; }; done
        [ "$hit" = 1 ]
        ;;
    list)
        for d in $(chromium_dirs); do
            [ -d "$d" ] || continue
            for f in "$d"/*.json; do
                [ -f "$f" ] || continue
                b=${f##*/}
                printf 'chromium\t%s\t%s\n' "${b%.json}" "$f"
            done
        done
        for d in $(firefox_dirs); do
            [ -d "$d" ] || continue
            for f in "$d"/*.json; do
                [ -f "$f" ] || continue
                b=${f##*/}
                printf 'firefox\t%s\t%s\n' "${b%.json}" "$f"
            done
        done
        ;;
    *) exit 2 ;;
esac
EOF
}

template_json_path() {
    # Runs on the HOST (the only generated helper that does; the precedent for
    # a host-side helper in libexec is sora-merge-index).
    #
    # It exists because a native-messaging manifest has to be rewritten with
    # exactly one string value changed and every other byte preserved:
    # 'allowed_origins' binds the manifest to a browser extension's ID and
    # cannot be invented, so the file is copied out of the box and edited, not
    # constructed. awk rather than jq or python3 because awk is already a hard
    # dependency of sora (the shell hook needs it) and those are not: an
    # adapter must not fail on a host where the rest of sora works.
    #
    # A scanner rather than a regex because a regex cannot tell a key from a
    # value. Here depth and string state are tracked, and a value is consumed
    # whole and never re-examined, so "description": "the path: /x" cannot
    # match, and an array element is both at depth 2 and not followed by ':'.
    cat <<'EOF'
#!/bin/sh
# sora-json-path — generated by sora. Runs on the HOST.
#   sora-json-path get     <file> <key>  -> the decoded string value
#   sora-json-path get-raw <file> <key>  -> the raw literal, escapes intact
#   sora-json-path set     <file> <key>  -> the whole file, that value replaced
#                                           (new value in $SORA_JP_VAL)
#   sora-json-path array-add <file> <key> -> the whole file, one string appended
#                                           to that top-level array
# Exit 1 = key absent. Exit 2 = usage or parse error. Only top-level keys.
set -u

mode=${1:-}
file=${2:-}
key=${3:-}
[ -n "$mode" ] && [ -n "$file" ] && [ -n "$key" ] || exit 2
[ -f "$file" ] || exit 2
case $mode in get|get-raw|set|array-add) ;; *) exit 2 ;; esac
case $mode in
    set|array-add) [ -z "${SORA_JP_VAL+x}" ] && exit 2 ;;
esac

# The trailing X is a sentinel: awk drops a final newline, and RS="\0" (or
# "^$") is not portable across gawk, mawk and busybox. Records are rejoined
# with \n and the X removed, so a file ending '}\n' and one ending '}' both
# reconstruct byte-exactly. CRLF survives because \r stays inside the record.
{ cat "$file"; printf X; } | awk -v mode="$mode" -v key="$key" '
    { buf = (NR == 1 ? $0 : buf "\n" $0) }
    END {
        buf = substr(buf, 1, length(buf) - 1)   # drop the sentinel
        n = length(buf)
        depth = 0; vs = 0; ve = 0; found = 0
        i = 1
        while (i <= n) {
            c = substr(buf, i, 1)
            if (c == "\"") {
                e = scan(buf, i, n)
                if (e == 0) exit 2
                j = e + 1
                while (j <= n && index(" \t\n\r", substr(buf, j, 1)) > 0) j++
                if (substr(buf, j, 1) == ":") {
                    # This string was a KEY.
                    if (depth == 1 && substr(buf, i + 1, e - i - 1) == key) {
                        k = j + 1
                        while (k <= n && index(" \t\n\r", substr(buf, k, 1)) > 0) k++
                        if (found) exit 2       # duplicate top-level key
                        if (mode == "array-add") {
                            # The insertion point is just before the matching
                            # ']', found by counting brackets from the opening
                            # one so a nested array cannot end it early.
                            if (substr(buf, k, 1) != "[") exit 2
                            d2 = 0; p = k
                            while (p <= n) {
                                ch2 = substr(buf, p, 1)
                                if (ch2 == "\"") { p = scan(buf, p, n); if (p == 0) exit 2 }
                                else if (ch2 == "[") d2++
                                else if (ch2 == "]") { d2--; if (d2 == 0) break }
                                p++
                            }
                            if (d2 != 0) exit 2
                            vs = k; ve = p; found = 1
                        } else {
                            if (substr(buf, k, 1) != "\"") exit 2
                            ve = scan(buf, k, n)
                            if (ve == 0) exit 2
                            vs = k; found = 1
                        }
                    }
                    i = j + 1
                } else {
                    i = e + 1                   # it was a VALUE; skip it whole
                }
            } else if (c == "{" || c == "[") { depth++; i++ }
            else if (c == "}" || c == "]")   { depth--; i++ }
            else                             { i++ }
        }
        if (depth != 0) exit 2
        if (!found) exit 1
        if (mode == "array-add") {
            # Everything between the brackets, to tell an empty array from one
            # that needs a separator.
            inner = substr(buf, vs + 1, ve - vs - 1)
            gsub(/[ \t\n\r]/, "", inner)
            # Insert right after the LAST element rather than before the
            # bracket, so a pretty-printed array keeps its closing bracket on
            # its own line instead of growing a stray trailing item beside it.
            # (No apostrophes in here: the whole awk program is single-quoted.)
            q = ve - 1
            while (q > vs && index(" \t\n\r", substr(buf, q, 1)) > 0) q--
            sep = (inner == "" ? "" : ", ")
            printf "%s", substr(buf, 1, q) sep "\"" ENVIRON["SORA_JP_VAL"] "\"" substr(buf, q + 1)
            exit 0
        }
        raw = substr(buf, vs + 1, ve - vs - 1)
        if (mode == "get-raw")   { printf "%s\n", raw; exit 0 }
        if (mode == "get")       { printf "%s\n", decode(raw); exit 0 }
        printf "%s", substr(buf, 1, vs) ENVIRON["SORA_JP_VAL"] substr(buf, ve)
        exit 0
    }
    # End offset of the string starting at the quote at p, honouring \\.
    function scan(s, p, len,   q, ch) {
        q = p + 1
        while (q <= len) {
            ch = substr(s, q, 1)
            if (ch == "\\") { q += 2; continue }
            if (ch == "\"") return q
            q++
        }
        return 0
    }
    function decode(s,   out, p, ch, nx) {
        out = ""; p = 1
        while (p <= length(s)) {
            ch = substr(s, p, 1)
            if (ch != "\\") { out = out ch; p++; continue }
            nx = substr(s, p + 1, 1)
            if      (nx == "n")  out = out "\n"
            else if (nx == "t")  out = out "\t"
            else if (nx == "r")  out = out "\r"
            else if (nx == "b")  out = out sprintf("%c", 8)
            else if (nx == "f")  out = out sprintf("%c", 12)
            else if (nx == "\"") out = out "\""
            else if (nx == "\\") out = out "\\"
            else if (nx == "/")  out = out "/"
            else exit 2          # \u and anything else: refuse rather than guess
            p += 2
        }
        return out
    }
'
EOF
}

template_capture_bash() {
    # Strategy B (live delegation): ask the BOX's own bash what it would offer
    # for a command line, and print one candidate per line. This is the only
    # strategy that sees candidates computed from the box's live state, and
    # the only one that costs a container round-trip on every single Tab,
    # which is why it is opt-in per command.
    cat <<'EOF'
#!/bin/bash
# sora-capture-bash — generated by sora. Runs INSIDE a box, as the user.
# Usage: sora-capture-bash COMP_LINE COMP_POINT
line=${1:-}
point=${2:-}
[ -n "$line" ] || exit 0
case $point in ''|*[!0-9]*) point=${#line} ;; esac
line=${line:0:$point}

for f in /usr/share/bash-completion/bash_completion \
         /usr/local/share/bash-completion/bash_completion \
         /etc/bash_completion; do
    if [ -r "$f" ]; then
        # shellcheck source=/dev/null
        . "$f" >/dev/null 2>&1
        break
    fi
done

# Split the line the way readline does for the simple cases. Quoting and
# escapes are deliberately NOT emulated: degrading to zero candidates is
# recoverable, offering wrong ones is not.
read -r -a COMP_WORDS <<< "$line"
case $line in *' ') COMP_WORDS+=("") ;; esac
[ ${#COMP_WORDS[@]} -gt 0 ] || exit 0
COMP_CWORD=$(( ${#COMP_WORDS[@]} - 1 ))
COMP_LINE=$line
COMP_POINT=${#line}
export COMP_LINE COMP_POINT

cmd=${COMP_WORDS[0]}
[ -n "$cmd" ] || exit 0
command -v "$cmd" >/dev/null 2>&1 || exit 0

# bash-completion registers nearly everything lazily, so the spec for this
# command usually does not exist until the loader is asked for it.
if declare -f _completion_loader >/dev/null 2>&1; then
    _completion_loader "$cmd" >/dev/null 2>&1
fi

spec=$(complete -p "$cmd" 2>/dev/null) || exit 0
func=$(printf '%s\n' "$spec" | sed -n 's/.*-F \([^ ]*\).*/\1/p')
[ -n "$func" ] || exit 0
declare -f "$func" >/dev/null 2>&1 || exit 0

prev=''
[ "$COMP_CWORD" -gt 0 ] && prev=${COMP_WORDS[COMP_CWORD-1]}

COMPREPLY=()
"$func" "$cmd" "${COMP_WORDS[COMP_CWORD]}" "$prev" >/dev/null 2>&1
[ ${#COMPREPLY[@]} -gt 0 ] || exit 0
printf '%s\n' "${COMPREPLY[@]}"
EOF
}

# Materialize the user-level helper scripts under ~/.local/share/sora/libexec.
# They live in the HOME on purpose: the home is bind-mounted inside every box
# at the same absolute path, so in-box hooks can call them directly.
ensure_libexec() {
    local d="$SORA_DATA/libexec" tmp src
    mkdir -p "$d"
    src="$SORA_SHARE/libexec/sora-merge-index"
    # Installing with PREFIX=$HOME/.local — what the recommended installer
    # does — makes SHAREDIR and SORA_DATA the very same directory, so source
    # and destination are one file and install(1) fails with "are the same
    # file" on every single command. -ef compares device+inode, so it also
    # covers the case where one side is a symlink to the other.
    if ! [ "$src" -ef "$d/sora-merge-index" ]; then
        install -m 0755 "$src" "$d/sora-merge-index"
    fi
    for gen in reindex detect-pm which capture-bash desktop-scan pkcs11 json-path native-messaging; do
        tmp="$d/.sora-$gen.tmp"
        "template_${gen//-/_}" > "$tmp"
        chmod 0755 "$tmp"
        mv -f "$tmp" "$d/sora-$gen"
    done
}

merge_now() {
    ensure_libexec
    "$SORA_DATA/libexec/sora-merge-index" "$SORA_CONFIG" "$SORA_CACHE" "$SORA_DATA"
}

# Emit "cmd \t prio \t box" candidates with pins boosted (shared by
# conflicts inspection; the merge script itself is standalone POSIX sh).
emit_candidates() {
    local f box prio meta
    for f in "$LISTS_DIR"/*.list; do
        [ -f "$f" ] || continue
        box=${f##*/}; box=${box%.list}
        prio=0
        meta="$BOXES_DIR/$box.toml"
        if [ -f "$meta" ]; then
            prio=$(toml_get "$meta" priority)
            [ -n "$prio" ] || prio=0
        fi
        awk -v b="$box" -v p="$prio" -v OFS='\t' 'NF == 1 { print $1, p, b }' "$f"
    done | awk -F'\t' -v OFS='\t' -v pins="$PINS" '
        BEGIN {
            while ((getline line < pins) > 0) {
                n = split(line, a, "\t")
                if (n >= 2) pin[a[1]] = a[2]
            }
        }
        { if (($1 in pin) && pin[$1] == $3) $2 = 1000000000; print }
    '
}

# ---------------------------------------------------------------------------
# Image catalog (advisory: any OCI image is accepted verbatim)
# ---------------------------------------------------------------------------

image_for_alias() {
    case $1 in
        fedora)              printf 'quay.io/fedora/fedora-toolbox:latest\n' ;;
        ubuntu)              printf 'docker.io/library/ubuntu:latest\n' ;;
        debian)              printf 'docker.io/library/debian:stable\n' ;;
        arch|archlinux)      printf 'docker.io/library/archlinux:latest\n' ;;
        opensuse|tumbleweed) printf 'registry.opensuse.org/opensuse/tumbleweed:latest\n' ;;
        alpine)              printf 'docker.io/library/alpine:latest\n' ;;
        *)                   printf '%s\n' "$1" ;;
    esac
}

cmd_images() {
    cat <<'EOF'
Known image aliases (any other OCI image reference is accepted as-is):

  fedora      quay.io/fedora/fedora-toolbox:latest
  ubuntu      docker.io/library/ubuntu:latest
  debian      docker.io/library/debian:stable
  arch        docker.io/library/archlinux:latest
  tumbleweed  registry.opensuse.org/opensuse/tumbleweed:latest
  alpine      docker.io/library/alpine:latest

Automatic reindex hooks are available for dnf5, apt and pacman boxes.
Other package managers work fine, but need a manual 'sora reindex <box>'
after installing packages.
EOF
}

# ---------------------------------------------------------------------------
# XDG dir symlinks (box home -> host dirs)
# ---------------------------------------------------------------------------

setup_xdg_links() { # boxhome
    # Trivial by design: the UID is identical inside and outside (keep-id) and
    # the real host home is bind-mounted at the same absolute path, so plain
    # symlinks work with no ACLs. Names are resolved with xdg-user-dir because
    # the folders are localized ("Documentos", "Imagens", ...).
    local boxhome=$1 d host base
    if ! command -v xdg-user-dir >/dev/null 2>&1; then
        warn "xdg-user-dir not found on the host; skipping XDG folder symlinks"
        return 0
    fi
    for d in DOCUMENTS DOWNLOAD MUSIC PICTURES VIDEOS DESKTOP PUBLICSHARE TEMPLATES; do
        host=$(xdg-user-dir "$d" 2>/dev/null) || continue
        [ -n "$host" ] && [ -d "$host" ] || continue
        [ "$host" = "$HOME" ] && continue   # xdg-user-dir falls back to $HOME
        base=${host##*/}
        if [ ! -e "$boxhome/$base" ] && [ ! -L "$boxhome/$base" ]; then
            ln -s "$host" "$boxhome/$base"
        fi
    done
}

# ---------------------------------------------------------------------------
# In-box hook installation
# ---------------------------------------------------------------------------

pm_family() { # detected binary -> hook type or "none"
    case $1 in
        dnf5)        printf 'dnf5\n' ;;
        apt-get|apt) printf 'apt\n' ;;
        pacman)      printf 'pacman\n' ;;
        *)           printf 'none\n' ;;
    esac
}

install_inbox_hooks() { # box pm-binary
    local box=$1 pm=$2 hooktype stage
    hooktype=$(pm_family "$pm")
    if [ "$hooktype" = none ]; then
        warn "no automatic reindex hook for '$pm'; run 'sora reindex $box' after installing packages"
        return 0
    fi

    # Stage under the cache (inside the home, visible in the box for the
    # user), then copy into container-private /tmp so that in-box ROOT can
    # read it (root cannot traverse the user's 0700 home under keep-id).
    mkdir -p "$SORA_CACHE"
    stage=$(mktemp -d "$SORA_CACHE/stage.XXXXXX")
    template_trigger "$box"            > "$stage/sora-index-refresh"
    template_pm_hook "$hooktype"       > "$stage/pm-hook"
    template_inbox_install "$hooktype" > "$stage/install-root.sh"
    chmod 0644 "$stage"/*

    distrobox enter --name "$box" -- rm -rf /tmp/.sora-stage &&
    distrobox enter --name "$box" -- cp -r "$stage" /tmp/.sora-stage &&
    distrobox enter --name "$box" -- sudo sh /tmp/.sora-stage/install-root.sh ||
        { rm -rf "$stage"; die "failed to install the reindex hook inside '$box'"; }
    distrobox enter --name "$box" -- rm -rf /tmp/.sora-stage || true
    rm -rf "$stage"
    info "installed $hooktype auto-reindex hook inside '$box' ($(pm_hook_path "$hooktype"))"
}

# ---------------------------------------------------------------------------
# sora box ...
# ---------------------------------------------------------------------------

cmd_box_create() {
    local name='' image='' priority=0 own_home=1 xdg_links=1 pm_override=''
    local hides=() h flags boxhome pm count
    local extra_flags=() use_nvidia=0

    while [ $# -gt 0 ]; do
        case $1 in
            --image)          image=${2:?--image needs a value}; shift ;;
            --priority)       priority=${2:?--priority needs a value}; shift ;;
            --pkg-manager)    pm_override=${2:?--pkg-manager needs a value}; shift ;;
            --no-own-home)    own_home=0 ;;
            --no-xdg-links)   xdg_links=0 ;;
            --hide)           hides+=("${2:?--hide needs a path}"); shift ;;
            --additional-flags|-a)
                              extra_flags+=("${2:?--additional-flags needs a value}"); shift ;;
            --nvidia)         use_nvidia=1 ;;
            -*)               die "unknown option for 'box create': $1" ;;
            *)                [ -z "$name" ] && name=$1 || die "unexpected argument: $1" ;;
        esac
        shift
    done

    [ -n "$name" ] || die "usage: sora box create <name> --image <image|alias> [options]"
    case $name in (*[!A-Za-z0-9._-]*) die "box name may only contain [A-Za-z0-9._-]" ;; esac
    box_configured "$name" && die "box '$name' is already managed by sora"
    [ -n "$image" ] || die "--image is required; see 'sora images' for the catalog (any OCI image works)"
    case $priority in (*[!0-9-]*|'') die "--priority must be an integer" ;; esac

    need_cmd distrobox
    container_manager >/dev/null
    container_exists "$name" && die "a container named '$name' already exists (not created by sora)"

    image=$(image_for_alias "$image")
    ensure_libexec

    local create_args=(create --name "$name" --image "$image" --yes)
    if [ "$own_home" = 1 ]; then
        # A dedicated home is ORGANIZATION, not isolation: it keeps box
        # packages from scattering dotfiles into the host home. The host home
        # stays bind-mounted at its absolute path regardless; use --hide for
        # sensitive subpaths.
        boxhome="$HOMES_DIR/$name"
        mkdir -p "$boxhome"
        create_args+=(--home "$boxhome")
    else
        boxhome="$HOME"
    fi
    if [ ${#hides[@]} -gt 0 ]; then
        flags=""
        for h in "${hides[@]}"; do
            case $h in /*) ;; *) h="$HOME/$h" ;; esac
            flags="$flags--mount type=tmpfs,dst=$h "
        done
        create_args+=(--additional-flags "${flags% }")
    fi
    # distrobox ACCUMULATES --additional-flags rather than replacing, so what
    # the user asks for is simply appended to whatever --hide contributed;
    # there is no string to merge and no ordering to get right.
    #
    # These go to the CONTAINER MANAGER (podman/docker) - devices, extra
    # volumes, a CDI reference. sora stays out of what they mean, the same way
    # it treats an image reference as opaque.
    for h in "${extra_flags[@]}"; do
        create_args+=(--additional-flags "$h")
    done
    # --nvidia is NOT a container-manager flag and cannot be passed as one: it
    # is distrobox's own, and it is what bind-mounts the host driver into the
    # guest. The nvidia/cuda images ship the toolkit and never the driver, so
    # without it CUDA initialises and finds no device.
    [ "$use_nvidia" = 1 ] && create_args+=(--nvidia)

    info "creating box '$name' from $image ..."
    distrobox "${create_args[@]}" || die "distrobox create failed"

    info "detecting package manager (first enter initializes the box; this can take a while) ..."
    if [ -n "$pm_override" ]; then
        pm=$pm_override
    else
        pm=$(distrobox enter --name "$name" -- "$SORA_DATA/libexec/sora-detect-pm") || pm=unknown
        pm=${pm:-unknown}
    fi
    info "package manager: $pm"

    mkdir -p "$BOXES_DIR"
    cat > "$(box_meta "$name")" <<EOF
# Managed by sora. Editing priority / package_manager by hand is fine.
image = "$image"
package_manager = "$pm"
home = "$boxhome"
priority = $priority
created = "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
last_indexed = ""
EOF

    if [ "$own_home" = 1 ] && [ "$xdg_links" = 1 ]; then
        setup_xdg_links "$boxhome"
        info "linked host XDG folders into the box home"
    fi

    install_inbox_hooks "$name" "$pm"

    info "building the command index ..."
    distrobox enter --name "$name" -- "$SORA_DATA/libexec/sora-reindex" "$name" ||
        warn "initial indexing failed; run 'sora reindex $name'"

    count=$(wc -l < "$LISTS_DIR/$name.list" 2>/dev/null || echo 0)
    info "box '$name' is ready: $count commands indexed"
    local hooked=0 sh
    for sh in bash zsh fish; do
        if hook_system_file "$sh" >/dev/null || hook_installed "$sh"; then
            hooked=1
            break
        fi
    done
    if [ "$hooked" = 0 ]; then
        info "next step: 'sora hook install' to enable late resolution in your shell"
    fi
}

cmd_box_list() {
    local meta name image pm prio last count status
    if ! ls "$BOXES_DIR"/*.toml >/dev/null 2>&1; then
        info "no boxes managed by sora yet - try 'sora box create'"
        return 0
    fi
    printf '%-16s %-9s %-10s %-9s %-9s %-21s %s\n' NAME PRIORITY PKG-MGR COMMANDS STATUS LAST-INDEXED IMAGE
    for meta in "$BOXES_DIR"/*.toml; do
        name=${meta##*/}; name=${name%.toml}
        image=$(toml_get "$meta" image)
        pm=$(toml_get "$meta" package_manager)
        prio=$(toml_get "$meta" priority)
        last=$(toml_get "$meta" last_indexed)
        count=$(wc -l < "$LISTS_DIR/$name.list" 2>/dev/null || echo 0)
        if container_exists "$name"; then status=ok; else status=MISSING; fi
        printf '%-16s %-9s %-10s %-9s %-9s %-21s %s\n' \
            "$name" "${prio:-0}" "${pm:-?}" "$count" "$status" "${last:--}" "$image"
    done
}

cmd_box_enter() {
    local name=${1:?usage: sora box enter <name>}
    require_box "$name"
    shift
    exec distrobox enter --name "$name" "$@"
}

cmd_box_rm() {
    local name='' assume_yes=0 delete_home=0 home box wrapper wcmd
    while [ $# -gt 0 ]; do
        case $1 in
            --yes|-y)      assume_yes=1 ;;
            --delete-home) delete_home=1 ;;
            -*)            die "unknown option for 'box rm': $1" ;;
            *)             [ -z "$name" ] && name=$1 || die "unexpected argument: $1" ;;
        esac
        shift
    done
    [ -n "$name" ] || die "usage: sora box rm <name> [--yes] [--delete-home]"
    require_box "$name"
    home=$(toml_get "$(box_meta "$name")" home)

    if [ "$assume_yes" != 1 ]; then
        confirm "remove box '$name' (container + sora metadata)?" || die "aborted"
    fi

    # Before 'distrobox rm', not after: undoing a provision runs modutil INSIDE
    # the box, so once the container is gone the undo silently cannot happen.
    provide_purge_box "$name"

    if container_exists "$name"; then
        distrobox rm --force "$name" || warn "distrobox rm failed; continuing with metadata cleanup"
    else
        info "container '$name' does not exist; cleaning up metadata only"
    fi

    # Drop anxious wrappers that point into this box, and any desktop entry
    # that launches one: an entry left behind is a menu icon that does
    # nothing, which is worse than no icon at all.
    if [ -f "$ANXIOUS_REG" ]; then
        while IFS=$TAB read -r wcmd box _ wrapper _; do
            if [ "$box" = "$name" ]; then
                rm -f "$wrapper"
                desktop_remove "$wcmd"
            fi
        done < "$ANXIOUS_REG"
        awk -F'\t' -v b="$name" '$2 != b' "$ANXIOUS_REG" > "$ANXIOUS_REG.tmp" &&
            mv "$ANXIOUS_REG.tmp" "$ANXIOUS_REG"
    fi
    # Drop pins that point into this box.
    if [ -f "$PINS" ] && grep -q "$TAB$name\$" "$PINS"; then
        awk -F'\t' -v b="$name" '$2 != b' "$PINS" > "$PINS.tmp" && mv "$PINS.tmp" "$PINS"
        info "removed pins targeting '$name'"
    fi

    rm -f "$(box_meta "$name")" "$LISTS_DIR/$name.list"
    merge_now
    info "box '$name' removed"

    if [ -n "$home" ] && [ "$home" != "$HOME" ] && [ -d "$home" ]; then
        if [ "$delete_home" = 1 ]; then
            rm -rf "$home"
            info "deleted box home $home"
        else
            info "box home kept at $home (use --delete-home to remove it)"
        fi
    fi
}

cmd_box_set_priority() {
    local name=${1:?usage: sora box set-priority <name> <integer>}
    local prio=${2:?usage: sora box set-priority <name> <integer>}
    require_box "$name"
    case $prio in (*[!0-9-]*|'') die "priority must be an integer" ;; esac
    toml_set "$(box_meta "$name")" priority "$prio" raw
    merge_now
    info "box '$name' priority set to $prio; index rebuilt"
}

cmd_box() {
    local sub=${1:-}
    [ -n "$sub" ] && shift || true
    case $sub in
        create)       cmd_box_create "$@" ;;
        list|ls)      cmd_box_list "$@" ;;
        enter)        cmd_box_enter "$@" ;;
        rm|remove)    cmd_box_rm "$@" ;;
        set-priority) cmd_box_set_priority "$@" ;;
        *) die "usage: sora box <create|list|enter|rm|set-priority> ..." ;;
    esac
}

# ---------------------------------------------------------------------------
# Index commands
# ---------------------------------------------------------------------------

cmd_reindex() {
    local boxes=() meta name any=0
    if [ $# -gt 0 ]; then
        boxes=("$@")
    else
        [ -d "$BOXES_DIR" ] || die "no boxes managed by sora yet"
        for meta in "$BOXES_DIR"/*.toml; do
            [ -f "$meta" ] || die "no boxes managed by sora yet"
            name=${meta##*/}; boxes+=("${name%.toml}")
        done
    fi
    need_cmd distrobox
    ensure_libexec
    for name in "${boxes[@]}"; do
        require_box "$name"
        if container_exists "$name"; then
            info "reindexing '$name' ..."
            distrobox enter --name "$name" -- "$SORA_DATA/libexec/sora-reindex" "$name" &&
                any=1 || warn "reindex failed for '$name'"
        else
            warn "container '$name' does not exist; skipping (consider 'sora box rm $name')"
        fi
    done
    # The in-box script already merges, but merge again so skipped/removed
    # boxes are reflected too.
    merge_now
    [ "$any" = 1 ] && info "index rebuilt: $(wc -l < "$INDEX") commands"
}

cmd_conflicts() {
    [ -d "$LISTS_DIR" ] || die "no index data yet - run 'sora reindex'"
    local out
    out=$(emit_candidates | sort -t "$TAB" -k1,1 -k2,2nr -k3,3 | awk -F'\t' '
        function flush(   i, tag) {
            if (n > 1) {
                tag = (prios[1] >= 1000000000) ? "pinned" : "priority " prios[1]
                printf "%-24s -> %-14s (%s)\n", cur, boxes[1], tag
                for (i = 2; i <= n; i++)
                    printf "%-24s    also in %-11s (priority %s)\n", "", boxes[i], prios[i]
            }
        }
        $1 != cur { flush(); cur = $1; n = 0 }
        { n++; boxes[n] = $3; prios[n] = $2 }
        END { flush() }
    ')
    if [ -n "$out" ]; then
        printf '%s\n' "$out"
    else
        info "no conflicts: every indexed command exists in exactly one box"
    fi
}

cmd_pin() {
    local cmd box list
    case ${1:-} in
        --list|-l)
            if [ -s "$PINS" ]; then
                awk -F'\t' '{ printf "%-24s -> %s\n", $1, $2 }' "$PINS"
            else
                info "no pins configured"
            fi
            ;;
        --remove|-r)
            cmd=${2:?usage: sora pin --remove <command>}
            [ -f "$PINS" ] && grep -q "^$cmd$TAB" "$PINS" || die "'$cmd' is not pinned"
            awk -F'\t' -v c="$cmd" '$1 != c' "$PINS" > "$PINS.tmp" && mv "$PINS.tmp" "$PINS"
            merge_now
            info "unpinned '$cmd'; index rebuilt"
            ;;
        -*|'')
            die "usage: sora pin <command> <box> | sora pin --list | sora pin --remove <command>"
            ;;
        *)
            cmd=$1
            box=${2:?usage: sora pin <command> <box>}
            require_box "$box"
            list="$LISTS_DIR/$box.list"
            if ! { [ -f "$list" ] && grep -Fqx "$cmd" "$list"; }; then
                warn "'$cmd' is not currently indexed in box '$box'; the pin stays dormant until it is"
            fi
            mkdir -p "$SORA_CONFIG"
            touch "$PINS"
            awk -F'\t' -v c="$cmd" '$1 != c' "$PINS" > "$PINS.tmp"
            printf '%s\t%s\n' "$cmd" "$box" >> "$PINS.tmp"
            mv "$PINS.tmp" "$PINS"
            merge_now
            info "pinned '$cmd' -> '$box'; index rebuilt"
            ;;
    esac
}

cmd_which() {
    local cmd=${1:?usage: sora which <command>} hostpath box found=0
    if hostpath=$(command -v -- "$cmd" 2>/dev/null); then
        printf 'host:  %s\n' "$hostpath"
        printf '       host binaries always win; the shell hook never fires for this command.\n'
        found=1
    fi
    if [ -r "$INDEX" ]; then
        box=$(awk -F'\t' -v c="$cmd" '$1 == c { print $2; exit }' "$INDEX")
        if [ -n "$box" ]; then
            printf 'index: box '\''%s'\'' -> distrobox enter --name %s -- %s\n' "$box" "$box" "$cmd"
            if [ -f "$PINS" ] && grep -q "^$cmd$TAB$box\$" "$PINS"; then
                printf '       (pinned)\n'
            fi
            found=1
        fi
    fi
    if [ "$found" = 0 ]; then
        printf "sora: '%s' was not found on the host nor in any box.\n" "$cmd" >&2
        return 1
    fi
}

# ---------------------------------------------------------------------------
# sora anxious — eager, on-demand export (delegates to distrobox-export)
# ---------------------------------------------------------------------------

anxious_list() {
    local cmd box sudo wrapper desk
    if [ -s "$ANXIOUS_REG" ]; then
        printf '%-20s %-16s %-6s %-8s %s\n' COMMAND BOX SUDO DESKTOP WRAPPER
        while IFS=$TAB read -r cmd box sudo wrapper _; do
            [ -n "$cmd" ] || continue
            desk=no
            [ -f "$(desktop_file "$cmd")" ] && desk=yes
            printf '%-20s %-16s %-6s %-8s %s\n' \
                "$cmd" "$box" "$([ "$sudo" = sudo ] && printf yes || printf no)" \
                "$desk" "$wrapper"
        done < "$ANXIOUS_REG"
    else
        info "nothing exported yet - try: sora anxious <command> --box <box>"
    fi
}

# Where each shell looks for a user-installed completion script for <cmd>.
# bash finds it lazily on the first Tab (no shell restart needed); zsh needs
# the directory in $fpath; fish scans its completions dir automatically.
# "Host binaries always win" is STRUCTURAL for late resolution: the hook only
# ever fires after PATH lookup already failed. Nothing enforced it for eager
# export, though, and $EXPORT_PATH usually precedes /usr/bin - so exporting a
# name the host already has silently hijacks it. That is the project's
# headline claim, so the export refuses rather than warns.
anxious_host_conflict() { # name -> prints the host path, or fails
    local p
    p=$(command -v -- "$1" 2>/dev/null) || return 1
    # Builtins, keywords and aliases resolve to a bare word rather than a
    # path, and no file in PATH can shadow them anyway.
    case $p in /*) ;; *) return 1 ;; esac
    # Our own wrapper from a previous export is not a conflict: re-running
    # 'sora anxious htop --box b' has to stay idempotent.
    [ "$p" = "$EXPORT_PATH/$1" ] && return 1
    printf '%s\n' "$p"
}

completion_target() { # shell cmd
    case $1 in
        bash) printf '%s/bash-completion/completions/%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}" "$2" ;;
        zsh)  printf '%s/zsh/site-functions/_%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}" "$2" ;;
        fish) printf '%s/fish/completions/%s.fish\n' "${XDG_CONFIG_HOME:-$HOME/.config}" "$2" ;;
    esac
}

# A tool may well have a 'completion' subcommand that means something else
# entirely, so never trust exit status alone: the output has to look like a
# completion script for THIS shell before it lands in the user's home.
#
# The per-shell patterns must not overlap. A plain "starts with complete"
# check is NOT enough: plenty of tools ignore the shell argument and print
# their bash script for every shell, and 'complete -F _t t' would then sail
# through the fish check and install a bash script as fish completion.
# COMPREPLY is the reliable bash/fish discriminator — fish has no such array.
completion_looks_valid() { # shell file
    case $1 in
        bash) grep -qE 'COMPREPLY|(^|[[:space:]])complete[[:space:]].*-[FCo][[:space:]]' "$2" ;;
        zsh)  grep -qE '#compdef|(^|[[:space:]])compdef[[:space:]]' "$2" ;;
        fish) grep -qE '(^|[[:space:]])complete[[:space:]].*-c[[:space:]]' "$2" &&
              ! grep -q 'COMPREPLY' "$2" ;;
    esac
}

zsh_fpath_has() { # dir
    zsh -c 'print -l $fpath' 2>/dev/null | grep -qxF "$1"
}

# Generate and install completion scripts for an anxious-exported command.
#
# Modern CLIs (cobra, clap, click) ship a generator: 'cmd completion bash'
# prints a script whose only dynamic part is a shell-out back to the command
# itself. Because the anxious wrapper IS a real file in PATH, that shell-out
# resolves like any host binary — so one script, generated once from inside
# the box, buys full dynamic completion on the host with no per-Tab machinery
# of sora's own. This is why it is tied to 'anxious' and not to late
# resolution: late resolution has no wrapper for the script to call.
anxious_install_completions() { # cmd box
    local cmd=$1 box=$2 shell target tmp dir installed=0
    for shell in bash zsh fish; do
        command -v "$shell" >/dev/null 2>&1 || continue
        tmp=$(mktemp)
        if ! distrobox enter --name "$box" -- "$cmd" completion "$shell" >"$tmp" 2>/dev/null ||
           [ ! -s "$tmp" ] || ! completion_looks_valid "$shell" "$tmp"; then
            rm -f "$tmp"
            continue
        fi
        target=$(completion_target "$shell" "$cmd")
        dir=$(dirname "$target")
        mkdir -p "$dir"
        chmod 0644 "$tmp"
        mv -f "$tmp" "$target"
        info "$shell: completion installed ($target)"
        installed=$((installed + 1))
        if [ "$shell" = zsh ] && ! zsh_fpath_has "$dir"; then
            warn "$dir is not in your zsh \$fpath; add this to ~/.zshrc BEFORE compinit:"
            warn "  fpath=($dir \$fpath)"
        fi
    done
    if [ "$installed" = 0 ]; then
        warn "'$cmd' does not generate completion scripts ('$cmd completion <shell>' failed)"
        warn "this is normal for tools not built with cobra/clap/click"
        return 1
    fi
    info "open a new shell (bash picks it up on the next Tab)"
}

anxious_remove_completions() { # cmd
    local cmd=$1 shell target removed=0
    for shell in bash zsh fish; do
        target=$(completion_target "$shell" "$cmd")
        [ -f "$target" ] || continue
        rm -f "$target"
        removed=$((removed + 1))
    done
    [ "$removed" -gt 0 ] && info "removed $removed completion script(s) for '$cmd'"
    return 0
}

# ---------------------------------------------------------------------------
# sora anxious --desktop — a .desktop entry for a GUI app living in a box
#
# distrobox-export --app already copies an EXISTING entry out of a box. This
# does the part it cannot:
#
#   * it works when the app ships no .desktop at all (tarball, AppImage, a
#     browser dropped into /opt) - the wizard builds the entry from answers;
#   * Exec= is the anxious wrapper itself, an absolute path to a real file in
#     PATH, so there is no 'distrobox enter' prefix and no quoting dance
#     around the % field codes;
#   * Icon= is a NAME, with every size extracted from the box into the host's
#     hicolor theme, so the theme still picks resolution and dark variant
#     (distrobox-export pins one absolute file and loses both);
#   * MimeType is settable, which is the only way a browser inside a box can
#     become the host's default http/https handler.
#
# Every field is both a question and a flag. Nothing here may block without a
# tty: the same command line has to work from a provisioning script.
# ---------------------------------------------------------------------------

# The 'sora-' prefix is not decoration: it is what makes removal a glob over
# files we know we own, which is why no path has to be recorded in the
# registry (see the note in anxious_remove).
desktop_file() { printf '%s\n' "$DESKTOP_DIR/sora-$1.desktop"; }

# Read one key from the [Desktop Entry] group.
#
# Anchored, and group-aware, on purpose. The unanchored version is exactly
# the bug distrobox-export ships: `sed "s|Name.*|&${label}|g"` appends its
# label to GenericName, to every Name[xx] translation and to X-GNOME-FullName.
desktop_get() { # file key
    awk -F= -v k="$2" '
        /^\[/    { ingroup = ($0 == "[Desktop Entry]"); next }
        !ingroup { next }
        index($0, k "=") == 1 { sub(/^[^=]*=/, ""); print; exit }
    ' "$1"
}

# A .desktop value is a single line. Anything else corrupts every key after
# it, so user input is stripped rather than trusted.
desktop_clean() { printf '%s' "$1" | tr -d '\r\n'; }

# Copy the box's own entry for <cmd> out to a host temp file, so its fields
# can seed the wizard. Failure is not an error: "this app has no .desktop" is
# the very case that has to work.
desktop_scan_entry() { # box cmd -> prints a host path
    local box=$1 cmd=$2 cm inbox dir
    cm=$(container_manager)
    inbox=$(distrobox enter --name "$box" -- \
        "$SORA_DATA/libexec/sora-desktop-scan" entry "$cmd" 2>/dev/null) || return 1
    [ -n "$inbox" ] || return 1
    dir=$(mktemp -d)
    if ! "$cm" cp "$box:$inbox" "$dir/entry.desktop" 2>/dev/null ||
        [ ! -s "$dir/entry.desktop" ]; then
        rm -rf "$dir"
        return 1
    fi
    printf '%s\n' "$dir/entry.desktop"
}

# Pull every size of the icon out of the box into the host's hicolor theme,
# all renamed to one stable name. Because they land as a themed set rather
# than one absolute file, Icon= can stay a bare name and the icon loader keeps
# doing its job: right size per context, dark variant, scaling.
desktop_import_icons() { # box iconname cmd -> prints how many landed
    local box=$1 icon=$2 cmd=$3 cm paths p rest size ext dest n=0
    cm=$(container_manager)
    paths=$(distrobox enter --name "$box" -- \
        "$SORA_DATA/libexec/sora-desktop-scan" icons "$icon" 2>/dev/null) || {
        printf '0\n'
        return 1
    }
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        ext=${p##*.}
        case $p in
            */hicolor/*)
                rest=${p#*/hicolor/}
                size=${rest%%/*}
                ;;
            *)
                # /usr/share/pixmaps has no size in the path. Scalable art can
                # go anywhere; a bitmap has to be guessed, and 48x48 is the
                # historical size of that directory.
                case $ext in
                    svg) size=scalable ;;
                    *)   size=48x48 ;;
                esac
                ;;
        esac
        dest="$ICON_DIR/hicolor/$size/apps"
        mkdir -p "$dest"
        "$cm" cp "$box:$p" "$dest/sora-$cmd.$ext" 2>/dev/null || continue
        n=$((n + 1))
    done <<EOF
$paths
EOF
    printf '%s\n' "$n"
    [ "$n" -gt 0 ]
}

desktop_remove_icons() { # cmd -> prints how many went
    local f n=0
    for f in "$ICON_DIR"/hicolor/*/apps/"sora-$1".*; do
        [ -f "$f" ] || continue
        rm -f "$f"
        n=$((n + 1))
    done
    printf '%s\n' "$n"
}

desktop_remove() { # cmd
    local file icons
    file=$(desktop_file "$1")
    [ -f "$file" ] || return 0
    rm -f "$file"
    icons=$(desktop_remove_icons "$1")
    desktop_refresh
    info "removed desktop entry for '$1' ($icons icon file(s))"
}

# The MIME cache is what makes MimeType= mean anything: without a refresh the
# entry exists but nothing routes http:// to it until something else happens
# to rebuild the database.
#
# Note what is deliberately NOT done here: gtk-update-icon-cache. The icon
# loader reads an uncached directory just fine, but once a cache file exists
# it wins over the directory - so building one would mean owning it forever,
# and a stale one hides the very icons that were just imported.
desktop_refresh() {
    command -v update-desktop-database >/dev/null 2>&1 &&
        update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1
    return 0
}

# Ask, unless the answer is already known or there is nobody to ask. With
# --no-prompt (or no tty) the default is taken silently, which is what makes
# every question below scriptable.
desktop_ask() { # varname prompt default
    local __var=$1 prompt=$2 def=$3 reply
    if [ "$DESK_PROMPT" != 1 ]; then
        printf -v "$__var" '%s' "$def"
        return 0
    fi
    if [ -n "$def" ]; then
        printf 'sora: %s [%s]: ' "$prompt" "$def"
    else
        printf 'sora: %s: ' "$prompt"
    fi
    IFS= read -r reply || reply=''
    [ -n "$reply" ] || reply=$def
    printf -v "$__var" '%s' "$(desktop_clean "$reply")"
}

# Which window-manager can be asked what is on screen right now. Wayland has
# no portable answer: wlroots compositors expose their own IPC, and GNOME
# Shell deliberately exposes nothing, so this is a best-effort list and the
# caller must survive an empty one.
wmclass_backend() {
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
        printf 'hyprctl\n'
    elif [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
        printf 'swaymsg\n'
    elif [ -n "${DISPLAY:-}" ] && command -v xprop >/dev/null 2>&1; then
        printf 'xprop\n'
    else
        return 1
    fi
}

wmclass_list() { # backend
    local ids id
    case $1 in
        hyprctl) hyprctl clients 2>/dev/null | sed -n 's/^[[:space:]]*class:[[:space:]]*//p' ;;
        swaymsg) swaymsg -t get_tree 2>/dev/null |
            grep -o '"app_id": *"[^"]*"' | sed 's/.*: *"//; s/"$//' ;;
        xprop)
            ids=$(xprop -root _NET_CLIENT_LIST 2>/dev/null | sed 's/.*# *//; s/,//g')
            for id in $ids; do
                case $id in 0x*) ;; *) continue ;; esac
                # WM_CLASS is a pair, "instance", "class". StartupWMClass is
                # matched against the SECOND one.
                xprop -id "$id" WM_CLASS 2>/dev/null |
                    sed -n 's/.*WM_CLASS(STRING) = .*, "\(.*\)"$/\1/p'
            done
            ;;
    esac
}

# StartupWMClass is what binds a running window back to this launcher. Get it
# wrong and the dock grows a second, generic icon beside the real one instead
# of grouping them. It cannot be read off the binary: it is whatever the
# toolkit sets at runtime, so the only honest source is a window that exists.
wmclass_detect() { # cmd -> prints the class
    local cmd=$1 backend before after new='' pid n=0
    backend=$(wmclass_backend) || return 1
    before=$(wmclass_list "$backend")
    info "starting '$cmd' to read its window class..."
    "$EXPORT_PATH/$cmd" >/dev/null 2>&1 &
    pid=$!
    while [ "$n" -lt 20 ]; do
        sleep 1
        n=$((n + 1))
        kill -0 "$pid" 2>/dev/null || break
        after=$(wmclass_list "$backend")
        new=$(printf '%s\n' "$after" | grep -vxF -f <(printf '%s\n' "$before") | head -n1)
        [ -n "$new" ] && break
    done
    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    [ -n "$new" ] || return 1
    printf '%s\n' "$new"
}

# The set that makes a browser eligible as the host's default handler. Kept
# deliberately short: these are the types a browser must claim to win
# x-scheme-handler, not every type it can technically open.
DESKTOP_BROWSER_MIME='text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;'

anxious_desktop() { # cmd box
    local cmd=$1 box=$2 entry='' icons=0 file exec_line code='' wm='' browser=0
    local name comment generic icon categories mime keywords wmclass

    mkdir -p "$DESKTOP_DIR"

    # Seed every default from the box's own entry when there is one. This is
    # what keeps the wizard down to "press Enter" for a packaged app, and
    # leaves real questions only for the case distrobox-export cannot serve.
    if entry=$(desktop_scan_entry "$box" "$cmd"); then
        info "found an entry inside '$box': $(desktop_get "$entry" Name)"
    else
        entry=''
        info "'$cmd' ships no .desktop inside '$box'; building one from scratch"
    fi

    if [ -n "$entry" ]; then
        name=$(desktop_get "$entry" Name)
        comment=$(desktop_get "$entry" Comment)
        generic=$(desktop_get "$entry" GenericName)
        icon=$(desktop_get "$entry" Icon)
        categories=$(desktop_get "$entry" Categories)
        mime=$(desktop_get "$entry" MimeType)
        keywords=$(desktop_get "$entry" Keywords)
        wm=$(desktop_get "$entry" StartupWMClass)
        code=$(desktop_get "$entry" Exec | grep -o '%[UuFf]' | head -n1)
    fi

    # A browser is not guessed from a list of names - that list is always out
    # of date. It is read off the entry: claiming the http scheme is what
    # being a browser MEANS to the desktop.
    case ${mime:-} in *x-scheme-handler/http*) browser=1 ;; esac
    [ "$DESK_BROWSER" = 1 ] && browser=1
    if [ "$browser" = 1 ]; then
        [ -n "${mime:-}" ]       || mime=$DESKTOP_BROWSER_MIME
        [ -n "${categories:-}" ] || categories='Network;WebBrowser;'
        [ -n "$code" ]           || code='%U'
    fi

    # Flags win over the box, the box wins over a bare guess, and whatever is
    # still unanswered becomes a question.
    name=${DESK_NAME:-${name:-$cmd}}
    icon=${DESK_ICON:-${icon:-$cmd}}
    comment=${DESK_COMMENT:-${comment:-}}
    generic=${DESK_GENERIC:-${generic:-}}
    categories=${DESK_CATEGORIES:-${categories:-Utility;}}
    mime=${DESK_MIME:-${mime:-}}
    keywords=${DESK_KEYWORDS:-${keywords:-}}
    wmclass=${DESK_WMCLASS:-${wm:-}}

    desktop_ask name       "name shown in the menu"        "$name"
    desktop_ask generic    "generic name (e.g. Web Browser)" "$generic"
    desktop_ask comment    "one-line description"          "$comment"
    desktop_ask icon       "icon name inside the box"      "$icon"
    desktop_ask categories "menu categories"               "$categories"
    desktop_ask mime       "MimeType (empty for none)"     "$mime"
    desktop_ask keywords   "search keywords"               "$keywords"

    case $mime in *x-scheme-handler/http*) browser=1 ;; esac
    [ "$browser" = 1 ] && [ -z "$code" ] && code='%U'

    # The icon has to exist ON THE HOST; the menu never looks inside the box.
    if icons=$(desktop_import_icons "$box" "$icon" "$cmd"); then
        info "imported $icons icon file(s) as 'sora-$cmd'"
        icon="sora-$cmd"
    else
        warn "no icon named '$icon' found inside '$box'"
        warn "the entry will use '$icon' and fall back to the host theme"
    fi

    # Inherit first: a StartupWMClass that came from the box is the upstream
    # packager's answer, and it is right. Only ask to launch the app when
    # there is nothing to inherit.
    if [ -z "$wmclass" ]; then
        if [ "$DESK_DETECT_WM" = 1 ] ||
            { [ "$DESK_PROMPT" = 1 ] && confirm "start '$cmd' once to detect its window class?"; }; then
            if wmclass=$(wmclass_detect "$cmd"); then
                info "detected StartupWMClass=$wmclass"
            else
                wmclass=''
                warn "could not detect a window class (already running, too slow, or"
                warn "a compositor with no window introspection, e.g. GNOME on Wayland)"
                warn "find it by hand and re-run with --wmclass:"
                warn "  X11/XWayland: xprop WM_CLASS   |   Wayland: the compositor's app_id"
            fi
        fi
    fi

    # Sanitize here, not at each source: a value can arrive from a flag, from
    # the box's entry or from an answer, and one embedded newline silently
    # turns every key after it into garbage.
    name=$(desktop_clean "$name")
    generic=$(desktop_clean "$generic")
    comment=$(desktop_clean "$comment")
    icon=$(desktop_clean "$icon")
    categories=$(desktop_clean "$categories")
    mime=$(desktop_clean "$mime")
    keywords=$(desktop_clean "$keywords")
    wmclass=$(desktop_clean "$wmclass")

    exec_line="$EXPORT_PATH/$cmd"
    case $exec_line in *' '*) exec_line="\"$exec_line\"" ;; esac
    [ -n "$code" ] && exec_line="$exec_line $code"

    file=$(desktop_file "$cmd")
    {
        printf '[Desktop Entry]\n'
        printf 'Type=Application\n'
        printf 'Version=1.0\n'
        printf 'Name=%s\n' "$name"
        [ -n "$generic" ] && printf 'GenericName=%s\n' "$generic"
        [ -n "$comment" ] && printf 'Comment=%s\n' "$comment"
        printf 'Exec=%s\n' "$exec_line"
        printf 'Icon=%s\n' "$icon"
        printf 'Terminal=%s\n' "$([ "$DESK_TERMINAL" = 1 ] && printf true || printf false)"
        [ -n "$categories" ] && printf 'Categories=%s\n' "$categories"
        [ -n "$mime" ] && printf 'MimeType=%s\n' "$mime"
        [ -n "$keywords" ] && printf 'Keywords=%s\n' "$keywords"
        [ -n "$wmclass" ] && printf 'StartupWMClass=%s\n' "$wmclass"
        printf 'StartupNotify=true\n'
        printf 'X-Sora-Box=%s\n' "$box"
    } > "$file"
    chmod 0644 "$file"
    [ -n "$entry" ] && rm -rf "$(dirname "$entry")"

    desktop_refresh
    info "wrote $file"

    if command -v desktop-file-validate >/dev/null 2>&1; then
        desktop-file-validate "$file" ||
            warn "desktop-file-validate reported the problems above"
    fi

    if [ "$browser" = 1 ] && command -v xdg-settings >/dev/null 2>&1; then
        if [ "$DESK_DEFAULT_BROWSER" = 1 ] ||
            { [ "$DESK_PROMPT" = 1 ] && confirm "make '$name' the host's default web browser?"; }; then
            if xdg-settings set default-web-browser "sora-$cmd.desktop"; then
                info "default browser is now sora-$cmd.desktop"
            else
                warn "xdg-settings refused; set it by hand in your desktop settings"
            fi
        fi
    fi
    return 0
}

anxious_remove() {
    local cmd=$1 line box binpath wrapper
    [ -f "$ANXIOUS_REG" ] || die "'$cmd' is not exported"
    line=$(awk -F'\t' -v c="$cmd" '$1 == c { print; exit }' "$ANXIOUS_REG")
    [ -n "$line" ] || die "'$cmd' is not exported"
    box=$(printf '%s' "$line" | cut -f2)
    wrapper=$(printf '%s' "$line" | cut -f4)
    binpath=$(printf '%s' "$line" | cut -f5)
    # 'distrobox-export --delete' derives what to delete from the BINARY name,
    # so for a wrapper renamed by --as it would delete $EXPORT_PATH/<binary>,
    # which may well be somebody else's export. Whether a rename happened is
    # derived by comparing the two names the registry already carries.
    if [ "${wrapper##*/}" = "${binpath##*/}" ] && container_exists "$box"; then
        distrobox enter --name "$box" -- distrobox-export --bin "$binpath" \
            --export-path "$EXPORT_PATH" --delete >/dev/null 2>&1 || rm -f "$wrapper"
    else
        rm -f "$wrapper"
    fi
    [ -e "$wrapper" ] && rm -f "$wrapper"
    awk -F'\t' -v c="$cmd" '$1 != c' "$ANXIOUS_REG" > "$ANXIOUS_REG.tmp" &&
        mv "$ANXIOUS_REG.tmp" "$ANXIOUS_REG"
    # Paths are derived, not recorded: keeping them out of the registry keeps
    # the on-disk format compatible with wrappers exported by older versions.
    anxious_remove_completions "$cmd"
    desktop_remove "$cmd"
    info "removed exported wrapper for '$cmd'"
}

cmd_anxious() {
    local cmd='' box='' use_sudo=0 mode=add with_completion=0 binpath sudoflag
    local with_desktop=0 path_flag='' as_name='' lookup base force=0 hostpath
    # Every --desktop question is also a flag, so the wizard degrades into a
    # one-liner for scripts. Defaults live here rather than in anxious_desktop
    # so that "unset" and "answered with an empty string" stay distinguishable.
    DESK_NAME='' DESK_COMMENT='' DESK_GENERIC='' DESK_ICON=''
    DESK_CATEGORIES='' DESK_MIME='' DESK_KEYWORDS='' DESK_WMCLASS=''
    DESK_BROWSER=0 DESK_TERMINAL=0 DESK_DETECT_WM=0 DESK_DEFAULT_BROWSER=0
    DESK_PROMPT=1
    while [ $# -gt 0 ]; do
        case $1 in
            --list|-l)         mode=list ;;
            --remove|-r)       mode=remove; [ $# -ge 2 ] && { cmd=$2; shift; } ;;
            --sudo)            use_sudo=1 ;;
            --with-completion) with_completion=1 ;;
            --box|-b)          box=${2:?--box needs a value}; shift ;;
            --path)            path_flag=${2:?--path needs a value}; shift ;;
            --as)              as_name=${2:?--as needs a value}; shift ;;
            --force)           force=1 ;;
            --desktop)         with_desktop=1 ;;
            --name)            DESK_NAME=${2:?--name needs a value}; shift ;;
            --comment)         DESK_COMMENT=${2:?--comment needs a value}; shift ;;
            --generic-name)    DESK_GENERIC=${2:?--generic-name needs a value}; shift ;;
            --icon)            DESK_ICON=${2:?--icon needs a value}; shift ;;
            --categories)      DESK_CATEGORIES=${2:?--categories needs a value}; shift ;;
            --mime)            DESK_MIME=${2:?--mime needs a value}; shift ;;
            --keywords)        DESK_KEYWORDS=${2:?--keywords needs a value}; shift ;;
            --wmclass)         DESK_WMCLASS=${2:?--wmclass needs a value}; shift ;;
            --browser)         DESK_BROWSER=1 ;;
            --terminal)        DESK_TERMINAL=1 ;;
            --detect-wmclass)  DESK_DETECT_WM=1 ;;
            --default-browser) DESK_DEFAULT_BROWSER=1 ;;
            --no-prompt)       DESK_PROMPT=0 ;;
            -*)                die "unknown option for 'anxious': $1" ;;
            *)                 [ -z "$cmd" ] && cmd=$1 || die "unexpected argument: $1" ;;
        esac
        shift
    done

    # Silence is the failure mode to avoid here: typing --icon without
    # --desktop would otherwise write a wrapper and quietly drop the icon.
    local desk_opts="$DESK_NAME$DESK_COMMENT$DESK_GENERIC$DESK_ICON"
    desk_opts="$desk_opts$DESK_CATEGORIES$DESK_MIME$DESK_KEYWORDS$DESK_WMCLASS"
    desk_opts="$desk_opts$DESK_BROWSER$DESK_TERMINAL$DESK_DETECT_WM$DESK_DEFAULT_BROWSER"
    if [ "$with_desktop" != 1 ] && [ "$desk_opts" != 0000 ]; then
        die "desktop-entry options only apply together with --desktop"
    fi
    # Nobody to answer the questions: fall back to defaults instead of
    # blocking forever on a read from a closed stdin.
    [ -t 0 ] || DESK_PROMPT=0

    case $mode in
        list)   anxious_list; return ;;
        remove) [ -n "$cmd" ] || die "usage: sora anxious --remove <command>"
                anxious_remove "$cmd"; return ;;
    esac

    # --path names the thing to resolve; a positional names it too. Accepting
    # both would silently drop one of them.
    if [ -n "$path_flag" ]; then
        [ -z "$cmd" ] || die "--path and a command name are mutually exclusive"
        case $path_flag in
            /*) ;;
            *)  die "--path must be an absolute path inside the box" ;;
        esac
        # The path is interpolated into the wrapper script distrobox-export
        # generates. A quote or a $ there produces a broken wrapper that only
        # fails when someone runs it.
        case $path_flag in
            *[[:space:]\"\'\$\`]*)
                die "--path may not contain whitespace, quotes, '\$' or backticks" ;;
        esac
    fi

    # The export name is the identity everywhere downstream: the wrapper
    # filename, the registry key, the completion target, the .desktop name.
    [ -n "$as_name" ] && cmd=$as_name
    [ -n "$cmd" ] || cmd=${path_flag##*/}

    [ -n "$cmd" ] || die "usage: sora anxious [--sudo] <command> --box <box>"
    [ -n "$box" ] || die "--box is required (which box provides '$cmd'?)"
    case $cmd in (*[!A-Za-z0-9._+-]*) die "command name may only contain [A-Za-z0-9._+-]" ;; esac

    # Before anything touches a container: this check is free, and failing it
    # late would mean waking a box only to refuse.
    if hostpath=$(anxious_host_conflict "$cmd"); then
        if [ "$force" = 1 ]; then
            warn "'$cmd' already exists on the host ($hostpath); --force: shadowing it"
        else
            warn "'$cmd' already exists on the host: $hostpath"
            warn "$EXPORT_PATH usually precedes /usr/bin, so this export would shadow it"
            warn "pick another name with --as, or pass --force to shadow it deliberately"
            die "refusing to shadow a host binary"
        fi
    fi

    need_cmd distrobox
    container_exists "$box" || die "container '$box' does not exist"
    box_configured "$box" || warn "box '$box' is not managed by sora; exporting anyway"

    ensure_libexec
    # 'command -v' answers both questions with one round-trip: for a name it
    # searches the box's PATH, and for an absolute path it echoes it back iff
    # it is executable. So --path needs no new in-box helper.
    lookup=${path_flag:-$cmd}
    binpath=$(distrobox enter --name "$box" -- "$SORA_DATA/libexec/sora-which" "$lookup") ||
        die "'$lookup' was not found (or is not executable) inside box '$box'"
    [ -n "$binpath" ] || die "'$lookup' was not found (or is not executable) inside box '$box'"

    mkdir -p "$EXPORT_PATH"
    local extra=()
    [ "$use_sudo" = 1 ] && extra+=(--sudo)
    distrobox enter --name "$box" -- distrobox-export --bin "$binpath" \
        --export-path "$EXPORT_PATH" "${extra[@]}" ||
        die "distrobox-export failed for '$cmd' in '$box'"

    # distrobox-export always names the wrapper after the binary. sora does not
    # reimplement wrapper generation (see docs/architecture.md), so --as is
    # honoured by renaming what it just wrote.
    base=${binpath##*/}
    if [ "$base" != "$cmd" ]; then
        mv -f "$EXPORT_PATH/$base" "$EXPORT_PATH/$cmd" ||
            die "distrobox-export wrote no wrapper at $EXPORT_PATH/$base"
    fi

    mkdir -p "$SORA_CONFIG"
    touch "$ANXIOUS_REG"
    sudoflag=nosudo; [ "$use_sudo" = 1 ] && sudoflag=sudo
    awk -F'\t' -v c="$cmd" '$1 != c' "$ANXIOUS_REG" > "$ANXIOUS_REG.tmp"
    printf '%s\t%s\t%s\t%s\t%s\n' "$cmd" "$box" "$sudoflag" "$EXPORT_PATH/$cmd" "$binpath" \
        >> "$ANXIOUS_REG.tmp"
    mv "$ANXIOUS_REG.tmp" "$ANXIOUS_REG"

    info "exported '$cmd' from '$box' -> $EXPORT_PATH/$cmd"
    if [ "$use_sudo" = 1 ]; then
        info "the wrapper runs '$cmd' with sudo INSIDE the container."
        info "type it WITHOUT host sudo ('$cmd ...', not 'sudo $cmd ...'):"
        info "host sudo would target podman's rootful storage and break everything."
    fi
    case ":$PATH:" in
        *":$EXPORT_PATH:"*) ;;
        *) warn "$EXPORT_PATH is not in your PATH; the wrapper will not be found" ;;
    esac

    # After the wrapper exists, not before: the generated script calls the
    # command by name, so it is only useful once that name resolves on the host.
    [ "$with_completion" = 1 ] && anxious_install_completions "$cmd" "$box"
    # Same ordering reason, harder consequence: Exec= points at the wrapper,
    # so writing the entry first would publish a launcher for a missing file.
    [ "$with_desktop" = 1 ] && anxious_desktop "$cmd" "$box"
    return 0
}

# ---------------------------------------------------------------------------
# sora provide — register a box resource at a host integration point
#
# Much of what people want out of a box is never typed by anyone: it is looked
# up by a host program at its own integration point. A browser looking for a
# signing helper, NSS looking for a PKCS#11 module, the desktop looking for a
# MIME handler. In every case the shape is the same - a host configuration
# file whose "run this" field points at something that enters the box - and
# only the file format changes.
#
# 'anxious --desktop' is the first adapter of that shape and stays where it
# is: a desktop entry is what an ordinary user wants without ever learning the
# phrase "integration point". This is the general form, for the ones that need
# to be named.
#
# See docs/rfc-provide.md for the reasoning and the measurements behind it.
# ---------------------------------------------------------------------------

provide_name() { printf 'sora-%s-%s\n' "$1" "$2"; }   # box label

provide_row() { # name -> the registry row, or empty
    [ -f "$PROVIDE_REG" ] || return 0
    awk -F'\t' -v n="$1" '$1 == n { print; exit }' "$PROVIDE_REG"
}

# Upsert and delete in one path, exactly like delegate_write.
provide_write() { # name kind box label nss target   (empty kind removes)
    mkdir -p "$SORA_CONFIG"
    touch "$PROVIDE_REG"
    awk -F'\t' -v n="$1" '$1 != n' "$PROVIDE_REG" > "$PROVIDE_REG.tmp"
    [ -n "$2" ] && printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" \
        >> "$PROVIDE_REG.tmp"
    mv "$PROVIDE_REG.tmp" "$PROVIDE_REG"
}

provide_count_kind() { # kind -> how many rows of that kind remain
    [ -f "$PROVIDE_REG" ] || { printf '0\n'; return 0; }
    awk -F'\t' -v k="$1" '$2 == k' "$PROVIDE_REG" | grep -c . || true
}

pkcs11_module_file() { printf '%s/%s.module\n' "$PKCS11_MODULES_DIR" "$1"; }

# p11-kit splits the value of 'remote:' on whitespace and has no quoting, so
# every component has to be whitespace-free or the file is valid and starts
# the wrong command. That is a die, never a warning.
distrobox_path() {
    local p
    p=$(command -v distrobox 2>/dev/null) ||
        die "'distrobox' is required but was not found in PATH"
    case $p in
        /*) ;;
        *)  die "distrobox did not resolve to an absolute path ($p)" ;;
    esac
    case $p in
        *[[:space:]]*)
            die "the path to distrobox contains whitespace ($p); p11-kit cannot quote it" ;;
    esac
    printf '%s\n' "$p"
}

# The absolute distrobox path is pinned INSIDE the generated file, which is the
# one place it has to be: a browser started from the desktop menu has a PATH
# that frequently lacks ~/.local/bin. Same reason --desktop writes an absolute
# Exec=.
pkcs11_module_content() { # name box lib
    cat <<EOF
# $1 — generated by sora $SORA_VERSION. Do not edit.
# The driver runs inside box '$2'; only this configuration exists on the host.
# Remove with: sora provide remove $1
remote: |$(distrobox_path) enter --name $2 -- p11-kit remote $3
EOF
}

# The exact command that installs what is missing, for THIS box's package
# manager. sora does not install anything into a box on the user's behalf here:
# publishing a module is not consent to change the box's package set.
pkg_install_hint() { # pm what
    case "$1/$2" in
        dnf5/p11-kit|dnf/p11-kit)    printf 'sudo dnf install p11-kit p11-kit-server\n' ;;
        apt/p11-kit|apt-get/p11-kit) printf 'sudo apt install p11-kit\n' ;;
        pacman/p11-kit)              printf 'sudo pacman -S p11-kit\n' ;;
        zypper/p11-kit)              printf 'sudo zypper install p11-kit p11-kit-tools\n' ;;
        apk/p11-kit)                 printf 'sudo apk add p11-kit p11-kit-server\n' ;;
        dnf5/modutil|dnf/modutil)    printf 'sudo dnf install nss-tools\n' ;;
        apt/modutil|apt-get/modutil) printf 'sudo apt install libnss3-tools\n' ;;
        pacman/modutil)              printf 'sudo pacman -S nss\n' ;;
        zypper/modutil)              printf 'sudo zypper install mozilla-nss-tools\n' ;;
        apk/modutil)                 printf 'sudo apk add nss-tools\n' ;;
        *) return 1 ;;
    esac
}

# Advisory, always. 'p11-kit list-modules' LOADS every module, and a driver is
# allowed to abort the process doing it, so this runs in a subshell with cores
# disabled and never decides anything.
pkcs11_verify_host() { # name
    local out
    if ! command -v p11-kit >/dev/null 2>&1; then
        warn "p11-kit is not installed on the HOST; the module file is written but nothing reads it yet"
        return 0
    fi
    out=$( ulimit -c 0 2>/dev/null; p11-kit list-modules 2>/dev/null ) || out=''
    case $out in
        *"$1"*) info "the host's p11-kit sees module '$1'" ;;
        *) warn "the host's p11-kit did not list '$1'; it may still work (a driver that aborts on load is expected)" ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# NSS registration
#
# The .module files are read by p11-kit. Chromium, Brave and Chrome reach
# p11-kit only through p11-kit-proxy.so registered in ~/.pki/nssdb, so without
# this step the modules exist and no browser sees them.
#
# Everything here is derived from state rather than recorded: pkcs11.txt in a
# sql: database is plain text, so "is it registered" is a grep, which stays
# honest across sora reinstalls and hand edits.
# ---------------------------------------------------------------------------

# SORA_SYSROOT is the same seam the system-wide hook lookup uses: empty in real
# use, a fixture root under test.
nss_proxy_lib() {
    local root="${SORA_SYSROOT:-}" p c
    if p=$(pkg-config --variable=proxy_module p11-kit-1 2>/dev/null) &&
        [ -n "$p" ] && [ -e "$root$p" ]; then
        printf '%s\n' "$root$p"
        return 0
    fi
    for c in /usr/lib64/pkcs11/p11-kit-proxy.so \
        /usr/lib/pkcs11/p11-kit-proxy.so \
        /usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-proxy.so \
        /usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-proxy.so \
        /usr/lib64/p11-kit-proxy.so \
        /usr/lib/x86_64-linux-gnu/p11-kit-proxy.so \
        /usr/lib/p11-kit-proxy.so; do
        [ -e "$root$c" ] && { printf '%s\n' "$root$c"; return 0; }
    done
    return 1
}

# A host database gets the PROXY; a database inside a Flatpak sandbox gets the
# CLIENT, which is a different library doing a different job. Two names,
# because ownership is derived from the name and confusing them would break the
# rule that sora only ever touches what sora wrote.
nss_ours() { grep -q "^name=${2:-$NSS_MODULE_NAME}\$" "$1/pkcs11.txt" 2>/dev/null; }

nss_foreign_proxy() { # dbdir [library-substring]
    grep -q "${2:-p11-kit-proxy\.so}" "$1/pkcs11.txt" 2>/dev/null
}

# One database is one of three things, read as TEXT rather than through
# 'modutil -list', which would load the modules.
nss_state() { # dbdir [name] [library-substring] -> ours | foreign | absent
    [ -f "$1/pkcs11.txt" ] || { printf 'absent\n'; return 0; }
    if nss_ours "$1" "${2:-}";              then printf 'ours\n'
    elif nss_foreign_proxy "$1" "${3:-}";   then printf 'foreign\n'
    else                                         printf 'absent\n'
    fi
}

nss_backup() { # dbdir
    local dest tag
    dest="$SORA_CACHE/nssdb"
    mkdir -p "$dest"
    # The database has to be part of the filename: with Firefox there are many,
    # and a timestamp alone collides for any two backed up in the same second.
    tag=$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_')
    dest="$dest/pkcs11.txt.$tag.$(date -u +%Y%m%dT%H%M%SZ)"
    cp -f "$1/pkcs11.txt" "$dest" 2>/dev/null || return 1
    info "backed up $1/pkcs11.txt to $dest"
}

# Firefox keeps one NSS database PER PROFILE, which is why writing the .module
# file and registering the proxy in ~/.pki/nssdb leaves every Firefox blind:
# that one database is the Chromium family's, shared.
#
# Both roots are scanned on purpose. Firefox 147 moved the profile to
# $XDG_CONFIG_HOME/mozilla/firefox, and the two coexist, because an upgraded
# install keeps the old path. Looking only in ~/.mozilla/firefox finds zero
# profiles on a freshly installed Firefox.
NSS_FIREFOX_ROOTS=".mozilla/firefox .librewolf .waterfox .zen .floorp"

nss_firefox_profiles() {
    local rel root p
    for rel in $NSS_FIREFOX_ROOTS; do
        for root in "$HOME/$rel" "$XDG_CONFIG_ROOT/${rel#.}"; do
            [ -d "$root" ] || continue
            # A profile is a directory with a prefs.js in it. profiles.ini is
            # not used: it takes both relative and absolute paths, and a
            # hand-made profile never appears there, while prefs.js is in all
            # of them, always. Globbing rather than 'find -printf', which is
            # GNU-only, for the same two depths.
            for p in "$root"/*/prefs.js "$root"/*/*/prefs.js; do
                [ -f "$p" ] && printf '%s\n' "${p%/prefs.js}"
            done
        done
    done
    return 0
}

# Every host NSS database sora registers into: the shared Chromium one, then
# one per Firefox profile. Flatpak profiles are deliberately absent - inside a
# sandbox the proxy is useless, because flatpak writes 'user-config: none' into
# every sandbox and no user module is read at all. That case needs
# p11-kit-client.so instead, and is a separate adapter.
nss_databases() {
    printf '%s\n' "$NSSDB_DIR"
    nss_firefox_profiles
}

# ---------------------------------------------------------------------------
# Flatpak browsers
#
# A .module file is useless inside a sandbox: flatpak writes
#   # Disable user pkcs11 config, because the host modules don't work in the runtime
#   user-config: none
# into /etc/pkcs11/pkcs11.conf of EVERY sandbox, from the flatpak binary rather
# than the runtime, so it holds for every app on every distribution. A file in
# the right place that nobody reads is worse than no file, because it looks
# like configuration.
#
# p11-kit-client.so escapes that because NSS loads it directly as a library and
# never consults the p11-kit user configuration. It talks to a p11-kit server
# over $XDG_RUNTIME_DIR/p11-kit/pkcs11, and that server exports everything the
# HOST has configured - including the remote modules 'provide pkcs11' wrote.
#
# Two things have to be true for it to work, and both loosen confinement, so
# sora prints them and never runs them.
# ---------------------------------------------------------------------------

NSS_CLIENT_NAME="sora-p11-kit-client"
NSS_P11_SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/p11-kit/pkcs11"

nss_socket_active() {
    systemctl --user is-active p11-kit-server.socket >/dev/null 2>&1 ||
        [ -S "$NSS_P11_SOCKET" ]
}

# The client as seen from INSIDE the sandbox: a runtime path, not a host one.
# Resolved through the app's declared runtime and checked against that
# runtime's installed tree, so we never write a path the sandbox does not have.
# In freedesktop 25.08 the client is under .../pkcs11/ while the proxy is one
# level up: they are interchangeable neither in place nor in function.
nss_flatpak_client() { # app-id -> in-sandbox path
    local runtime loc inner
    command -v flatpak >/dev/null 2>&1 || return 1
    runtime=$(flatpak info -m "$1" 2>/dev/null | sed -n 's/^runtime=//p' | head -n1)
    [ -n "$runtime" ] || return 1
    loc=$(flatpak info --show-location "runtime/$runtime" 2>/dev/null) || return 1
    [ -n "$loc" ] || return 1
    for inner in /usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so \
        /usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so \
        /usr/lib64/pkcs11/p11-kit-client.so \
        /usr/lib/pkcs11/p11-kit-client.so; do
        [ -e "$loc/files${inner#/usr}" ] && { printf '%s\n' "$inner"; return 0; }
    done
    return 1
}

# The NSS databases of one Flatpak browser. Chromium keeps a single one;
# Firefox keeps one per profile, under both the old and the XDG root.
nss_flatpak_dbs() { # app-id
    local base rel root p
    base="$HOME/.var/app/$1"
    [ -d "$base/.pki/nssdb" ] && printf '%s\n' "$base/.pki/nssdb"
    for rel in $NSS_FIREFOX_ROOTS; do
        for root in "$base/$rel" "$base/config/${rel#.}"; do
            [ -d "$root" ] || continue
            for p in "$root"/*/prefs.js "$root"/*/*/prefs.js; do
                [ -f "$p" ] && printf '%s\n' "${p%/prefs.js}"
            done
        done
    done
    return 0
}

# Installed Flatpak apps that look like a browser, i.e. that have a config tree
# sora knows how to find a database in. Uninstalled leftovers are filtered by
# nm_flatpak_installed, for the same reason the native-messaging adapter does
# it: the directory outlives the Flatpak.
nss_flatpak_apps() {
    local dir app
    for dir in "$HOME"/.var/app/*; do
        [ -d "$dir" ] || continue
        app=${dir##*/}
        nm_flatpak_installed "$app" || continue
        [ -n "$(nss_flatpak_dbs "$app")" ] && printf '%s\n' "$app"
    done
    return 0
}

# modutil lives inside a box, not on the host: the host's NSS database is
# bind-mounted into every box at the same absolute path and uses the same sql:
# format, so the box's modutil can write it - and the host does not need
# nss-tools installed at all.
nss_modutil_box() { # preferred
    local meta name
    [ -n "$1" ] && container_exists "$1" && { printf '%s\n' "$1"; return 0; }
    for meta in "$BOXES_DIR"/*.toml; do
        [ -f "$meta" ] || break
        name=${meta##*/}; name=${name%.toml}
        container_exists "$name" && { printf '%s\n' "$name"; return 0; }
    done
    return 1
}

nss_register() { # box
    local proxy db n=0 skipped=0
    if ! proxy=$(nss_proxy_lib); then
        warn "p11-kit-proxy.so was not found on the host; browsers will not see the module"
        warn "install your distribution's p11-kit package, then re-run this command"
        return 0
    fi
    ensure_libexec
    # One database per Firefox profile, plus the shared Chromium one. A profile
    # that cannot be written must not stop the others, so every failure here is
    # a warn.
    while IFS= read -r db; do
        [ -n "$db" ] || continue
        case $(nss_state "$db") in
            ours) n=$((n + 1)); continue ;;
            foreign)
                info "$db already has a p11-kit proxy registered by something else; leaving it alone"
                skipped=$((skipped + 1)); continue ;;
        esac
        nss_register_one "$1" "$db" "$proxy" && n=$((n + 1))
    done <<EOF
$(nss_databases)
EOF
    [ "$n" -gt 0 ] && info "the proxy is registered in $n NSS database(s)"
    nss_register_flatpak "$1"
    return 0
}

nss_register_flatpak() { # box
    local app client db hinted=0 n=0
    while IFS= read -r app; do
        [ -n "$app" ] || continue
        if ! client=$(nss_flatpak_client "$app"); then
            warn "$app: no p11-kit-client.so in its runtime; skipping"
            continue
        fi
        while IFS= read -r db; do
            [ -n "$db" ] || continue
            case $(nss_state "$db" "$NSS_CLIENT_NAME" 'p11-kit-client\.so') in
                ours) n=$((n + 1)); continue ;;
                foreign)
                    info "$db already has a p11-kit client registered by something else; leaving it alone"
                    continue ;;
            esac
            mkdir -p "$db"
            [ -f "$db/pkcs11.txt" ] && nss_backup "$db"
            distrobox enter --name "$1" -- \
                "$SORA_DATA/libexec/sora-pkcs11" nss-add "$db" "$client" "$NSS_CLIENT_NAME" \
                >/dev/null 2>&1 || true
            if nss_ours "$db" "$NSS_CLIENT_NAME"; then
                info "registered the p11-kit client in $db"
                n=$((n + 1))
            else
                warn "could not register the p11-kit client in $db"
            fi
        done <<EOF2
$(nss_flatpak_dbs "$app")
EOF2
        [ "$hinted" = 0 ] && {
            hinted=1
            # Both of these loosen confinement, and the socket exposes EVERY
            # PKCS#11 module the host has configured to the sandbox, not only
            # the box's. That is the machine owner's call, so sora prints and
            # never runs them.
            nss_socket_active ||
                info "the p11-kit socket is not active; run:  systemctl --user enable --now p11-kit-server.socket"
        }
        info "for the Flatpak browser $app, run:"
        info "  flatpak override --user --filesystem=xdg-run/p11-kit/pkcs11 $app"
    done <<EOF
$(nss_flatpak_apps)
EOF
    [ "$n" -gt 0 ] && info "the p11-kit client is registered in $n Flatpak database(s)"
    return 0
}

nss_register_one() { # box dbdir proxy
    local result pm hint
    mkdir -p "$2"
    [ -f "$2/pkcs11.txt" ] && nss_backup "$2"
    result=$(distrobox enter --name "$1" -- \
        "$SORA_DATA/libexec/sora-pkcs11" nss-add "$2" "$3" "$NSS_MODULE_NAME" \
        2>/dev/null) || result=failed
    # modutil's exit status is not the answer: a -rawadd into a database that
    # does not exist yet is silently dropped and still reports success. The
    # file is re-read instead.
    if nss_ours "$2"; then
        info "registered $3 in $2 as $NSS_MODULE_NAME"
        return 0
    fi
    case $result in
        no-modutil)
            pm=$(toml_get "$(box_meta "$1")" package_manager)
            warn "box '$1' has no 'modutil', so $2 was not touched"
            hint=$(pkg_install_hint "$pm" modutil) &&
                warn "run:  sora box enter $1 -- $hint"
            warn "the module file is in place; browsers will see it once NSS knows the proxy" ;;
        *) warn "registering the proxy in $2 failed; the module file is still in place" ;;
    esac
    return 1
}

nss_unregister() { # box
    local box db n=0
    if ! box=$(nss_modutil_box "$1"); then
        warn "no running box to run 'modutil' in; the NSS databases still list $NSS_MODULE_NAME"
        return 0
    fi
    ensure_libexec
    while IFS= read -r db; do
        [ -n "$db" ] || continue
        # The one guard that makes the undo safe: if the entry is not the one
        # we named, we did not create it and we do not touch it. This is why
        # the module name carries the sora- prefix.
        [ "$(nss_state "$db")" = ours ] || continue
        nss_unregister_one "$box" "$db" && n=$((n + 1))
    done <<EOF
$(nss_databases)
EOF
    [ "$n" -gt 0 ] && info "removed $NSS_MODULE_NAME from $n NSS database(s)"
    # Flatpak databases carry the client, not the proxy, so they are undone
    # under their own name. Permissions are NOT revoked: sora did not grant
    # them, and something else may rely on them.
    local app db m=0
    while IFS= read -r app; do
        [ -n "$app" ] || continue
        while IFS= read -r db; do
            [ -n "$db" ] || continue
            [ "$(nss_state "$db" "$NSS_CLIENT_NAME" 'p11-kit-client\.so')" = ours ] || continue
            nss_backup "$db"
            distrobox enter --name "$box" -- \
                "$SORA_DATA/libexec/sora-pkcs11" nss-del "$db" "$NSS_CLIENT_NAME" \
                >/dev/null 2>&1 || true
            if nss_ours "$db" "$NSS_CLIENT_NAME"; then
                warn "could not remove $NSS_CLIENT_NAME from $db"
                warn "remove it by hand with:  modutil -delete $NSS_CLIENT_NAME -dbdir sql:$db"
            else
                m=$((m + 1))
            fi
        done <<EOF2
$(nss_flatpak_dbs "$app")
EOF2
    done <<EOF
$(nss_flatpak_apps)
EOF
    [ "$m" -gt 0 ] && info "removed $NSS_CLIENT_NAME from $m Flatpak database(s)"
    return 0
}

nss_unregister_one() { # box dbdir
    local result
    nss_backup "$2"
    result=$(distrobox enter --name "$1" -- \
        "$SORA_DATA/libexec/sora-pkcs11" nss-del "$2" "$NSS_MODULE_NAME" \
        2>/dev/null) || result=failed
    if nss_ours "$2"; then
        # Never hand-edit pkcs11.txt: what is left is an orphan registration of
        # the HOST's own proxy with no modules behind it, which is inert.
        warn "could not remove $NSS_MODULE_NAME from $2 (modutil said: $result)"
        warn "remove it by hand with:  modutil -delete $NSS_MODULE_NAME -dbdir sql:$2"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Native messaging: where the host's browsers look for a manifest
#
# Discovery is keyed on the browser's CONFIG ROOT existing, not on the
# NativeMessagingHosts subdirectory, which we are the ones creating.
#
# Flatpak is handled generically, with no list of app ids, because a fixed list
# is exactly what rots: the reference implementation this feature grew out of
# already shipped without Edge and Vivaldi, and with a Brave-Origin that does
# not exist on the machine it was written on.
# ---------------------------------------------------------------------------

NM_CHROMIUM_RELS="chromium google-chrome google-chrome-beta google-chrome-unstable
BraveSoftware/Brave-Browser BraveSoftware/Brave-Browser-Beta BraveSoftware/Brave-Origin
microsoft-edge microsoft-edge-beta microsoft-edge-dev vivaldi vivaldi-snapshot
opera opera-beta thorium"

NM_FIREFOX_RELS=".mozilla .librewolf .waterfox .zen .floorp"

# Prints one existing directory per line, as <kind><TAB><dir>, where kind is
# 'native' or 'flatpak' - the two need different manifests, because a Flatpak
# browser cannot execute a host binary directly.
nm_manifest_dirs() { # family
    local rel base d
    case $1 in
        chromium)
            for rel in $NM_CHROMIUM_RELS; do
                d="$XDG_CONFIG_ROOT/$rel"
                [ -d "$d" ] && printf 'native\t%s/NativeMessagingHosts\n' "$d"
            done
            for base in "$HOME"/.var/app/*/config; do
                [ -d "$base" ] || continue
                for rel in $NM_CHROMIUM_RELS; do
                    d="$base/$rel"
                    [ -d "$d" ] && printf 'flatpak\t%s/NativeMessagingHosts\n' "$d"
                done
            done
            ;;
        firefox)
            for rel in $NM_FIREFOX_RELS; do
                d="$HOME/$rel"
                [ -d "$d" ] && printf 'native\t%s/native-messaging-hosts\n' "$d"
            done
            for base in "$HOME"/.var/app/*; do
                [ -d "$base" ] || continue
                for rel in $NM_FIREFOX_RELS; do
                    d="$base/$rel"
                    [ -d "$d" ] && printf 'flatpak\t%s/native-messaging-hosts\n' "$d"
                done
            done
            ;;
    esac
    return 0
}

# The flatpak app id owning a discovered directory, for the override hint.
nm_flatpak_app() { # dir -> app id
    local rest
    case $1 in
        "$HOME"/.var/app/*) rest=${1#"$HOME"/.var/app/}; printf '%s\n' "${rest%%/*}" ;;
        *) return 1 ;;
    esac
}

# Is this Flatpak app actually installed?
#
# A directory under ~/.var/app OUTLIVES the Flatpak: uninstalling leaves the
# app's config tree behind. Discovery keyed on directories alone therefore
# writes a manifest and an executable shim for a sandbox that no longer exists.
#
# This is deliberately NOT folded into nm_manifest_dirs, which also feeds
# removal and counting: an app uninstalled AFTER sora wrote to it must still be
# cleaned up, so the filter belongs on the write path only.
#
# 'flatpak list' is read-only and asks nothing of the sandbox. The answer is
# cached because discovery runs once per browser family.
NM_FLATPAK_APPS=''
nm_flatpak_installed() { # app-id
    if [ -z "$NM_FLATPAK_APPS" ]; then
        command -v flatpak >/dev/null 2>&1 || { NM_FLATPAK_APPS=$TAB; return 1; }
        NM_FLATPAK_APPS=$TAB$(flatpak list --app --columns=application 2>/dev/null |
            tr '\n' "$TAB")
    fi
    case $NM_FLATPAK_APPS in
        *"$TAB$1$TAB"*) return 0 ;;
        *) return 1 ;;
    esac
}

# Where a Flatpak browser's shim lives: inside the app's own config tree, which
# is always readable from inside its sandbox without any filesystem grant.
nm_flatpak_shim() { # manifest-dir host-name -> shim path
    local app
    app=$(nm_flatpak_app "$1") || return 1
    printf '%s/.var/app/%s/config/sora/%s.sh\n' "$HOME" "$app" "$2"
}

# 'com.lacunasoftware.webpki' -> 'webpki-lacuna'.
#
# The last component names the tool and the vendor component disambiguates it,
# which is the convention the reference implementation arrived at by hand to
# avoid colliding with host binaries. A heuristic, which is why --as exists and
# why both 'provide list' and 'doctor' always show the wrapper name.
nm_wrapper_name() { # host-name
    local last vendor rest
    last=${1##*.}
    rest=${1%.*}
    vendor=${rest##*.}
    # Corporate suffixes carry no information: lacunasoftware -> lacuna.
    case $vendor in
        *software) [ ${#vendor} -gt 11 ] && vendor=${vendor%software} ;;
        *soft)     [ ${#vendor} -gt 7 ]  && vendor=${vendor%soft} ;;
    esac
    # A bare TLD is not a vendor ('com.webpki'), and a vendor that repeats the
    # tool name adds nothing ('org.keepassxc.keepassxc_browser').
    case $vendor in
        com|org|net|br|io|dev|app|"$1") vendor='' ;;
    esac
    case $last in
        "$vendor"*|*"$vendor") [ -n "$vendor" ] && vendor='' ;;
    esac
    [ -n "$vendor" ] && printf '%s-%s\n' "$last" "$vendor" || printf '%s\n' "$last"
}

# A manifest is OURS iff its path field points at the wrapper we created. Same
# discipline as nss_ours(): ownership is derived from the file, never recorded,
# so an undo can never touch something sora did not write.
nm_is_ours() { # file wrapper
    local p
    p=$("$SORA_DATA/libexec/sora-json-path" get "$1" path 2>/dev/null) || return 1
    case $p in
        "$EXPORT_PATH/$2") return 0 ;;
        "$HOME"/.var/app/*/config/sora/*) return 0 ;;   # a Flatpak shim of ours
    esac
    return 1
}

nm_count_installed() { # host-name wrapper -> how many of our manifests exist
    local line dir f n=0
    while IFS=$TAB read -r _ dir; do
        [ -n "$dir" ] || continue
        f="$dir/$1.json"
        [ -f "$f" ] || continue
        nm_is_ours "$f" "$2" && n=$((n + 1))
    done <<EOF
$(nm_manifest_dirs chromium; nm_manifest_dirs firefox)
EOF
    printf '%s\n' "$n"
}

# How many OTHER provisions share this wrapper. A wrapper only goes when its
# last user does, exactly like the NSS registration.
nm_wrapper_refcount() { # wrapper except-name
    [ -f "$PROVIDE_REG" ] || { printf '0\n'; return 0; }
    awk -F'\t' -v w="$1" -v x="$2" \
        '$2 == "native-messaging" && $5 == w && $1 != x' "$PROVIDE_REG" | grep -c . || true
}

nm_remove_files() { # host-name wrapper
    local kind dir f n=0 shim
    while IFS=$TAB read -r kind dir; do
        [ -n "$dir" ] || continue
        f="$dir/$1.json"
        [ -f "$f" ] || continue
        if ! nm_is_ours "$f" "$2"; then
            warn "left $f alone: it is not the manifest sora wrote"
            continue
        fi
        rm -f "$f"
        n=$((n + 1))
        if [ "$kind" = flatpak ] && shim=$(nm_flatpak_shim "$dir" "$1"); then
            [ -f "$shim" ] && rm -f "$shim"
        fi
    done <<EOF
$(nm_manifest_dirs chromium; nm_manifest_dirs firefox)
EOF
    info "removed $n manifest(s) for '$1'"
    return 0
}

provide_list() {
    local name kind box label nss target status
    if [ ! -s "$PROVIDE_REG" ]; then
        info "nothing provided yet - try one of:"
        info "  sora provide pkcs11 <library> --box <box> --label <label>"
        info "  sora provide native-messaging <host-name> --box <box>"
        return 0
    fi
    printf '%-38s %-17s %-10s %-26s %-14s %-7s %s\n' \
        NAME KIND BOX LABEL DETAIL STATUS TARGET
    while IFS=$TAB read -r name kind box label nss target; do
        [ -n "$name" ] || continue
        status=ok
        case $kind in
            pkcs11) [ -f "$(pkcs11_module_file "$name")" ] || status=NO-FILE ;;
            native-messaging)
                [ -x "$EXPORT_PATH/$nss" ] || status=NO-WRAP
                [ "$(nm_count_installed "$label" "$nss")" = 0 ] && status=NO-FILE ;;
            *) status='?' ;;
        esac
        container_exists "$box" || status=MISSING
        # The DETAIL column is per-kind: nss/nonss for pkcs11, the wrapper
        # name for native-messaging. A derived wrapper name should never be
        # something the user has to guess at.
        printf '%-38s %-17s %-10s %-26s %-14s %-7s %s\n' \
            "$name" "$kind" "$box" "$label" "$nss" "$status" "$target"
    done < "$PROVIDE_REG"
}

# Removes the host-side files of one provision, not its registry row. An empty
# kind means "the caller does not know", which is the orphan case and is still
# pkcs11: a .module file is by definition one.
provide_remove_one() { # name kind label detail
    local name=$1 kind=${2:-} file
    case $kind in
        native-messaging) nm_remove_files "$3" "$4" ;;
        pkcs11|'')
            file=$(pkcs11_module_file "$name")
            [ -f "$file" ] && { rm -f "$file"; info "removed $file"; }
            ;;
        *) warn "unknown provision kind '$kind' for '$name'; no host file was removed" ;;
    esac
    return 0
}

cmd_provide_remove() {
    local name=${1:?usage: sora provide remove <name>} row kind box label nss
    row=$(provide_row "$name")
    # The file is removed whether or not a row exists: 'provide' writes the
    # file before the row, and an orphan file is exactly what that window
    # leaves behind.
    if [ -z "$row" ]; then
        if [ -f "$(pkcs11_module_file "$name")" ]; then
            provide_remove_one "$name"
            info "'$name' had no registry row; removed the orphan module file"
            return 0
        fi
        die "'$name' is not provided"
    fi
    kind=$(printf '%s' "$row" | cut -f2)
    box=$(printf '%s' "$row" | cut -f3)
    label=$(printf '%s' "$row" | cut -f4)
    nss=$(printf '%s' "$row" | cut -f5)

    provide_remove_one "$name" "$kind" "$label" "$nss"
    provide_write "$name" '' '' '' '' ''
    info "removed provision '$name'"

    # NSS registration is a singleton keyed on "at least one pkcs11 provision
    # that asked for it", so it only goes when the last one does. Undoing it
    # BEFORE the file was removed would leave the module live for gnutls and
    # Firefox while invisible to Chromium, which is undiagnosable.
    if [ "$kind" = pkcs11 ] && [ "$nss" = nss ] &&
        [ "$(provide_count_kind pkcs11)" = 0 ]; then
        nss_unregister "$box"
    fi

    # The wrapper is shared the same way the NSS registration is, so it only
    # goes with its last user. And anxious_remove DIES when there is no row for
    # the command, which would abort this function, provide_purge_box, and
    # therefore 'box rm' halfway - so the row is checked first.
    if [ "$kind" = native-messaging ]; then
        if [ "$(nm_wrapper_refcount "$nss" "$name")" != 0 ]; then
            info "wrapper '$nss' still backs another provision; keeping it"
        elif [ -f "$ANXIOUS_REG" ] &&
            awk -F'\t' -v c="$nss" '$1 == c { found = 1 } END { exit !found }' "$ANXIOUS_REG"; then
            anxious_remove "$nss"
        else
            warn "no anxious row for '$nss'; leaving $EXPORT_PATH/$nss alone"
        fi
    fi
}

provide_purge_box() { # box
    local names name
    [ -f "$PROVIDE_REG" ] || return 0
    # The whole list is collected BEFORE removing anything: each removal
    # rewrites the registry, and iterating a file while it is being replaced
    # underneath drops rows.
    names=$(awk -F'\t' -v b="$1" '$3 == b { print $1 }' "$PROVIDE_REG")
    [ -n "$names" ] || return 0
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        cmd_provide_remove "$name"
    done <<EOF
$names
EOF
}

cmd_provide_pkcs11() {
    local lib='' box='' label='' want_nss=1 name file pm probe row exbox exlabel
    while [ $# -gt 0 ]; do
        case $1 in
            --box|-b) box=${2:?--box needs a value}; shift ;;
            --label)  label=${2:?--label needs a value}; shift ;;
            --no-nss) want_nss=0 ;;
            -*)       die "unknown option for 'provide pkcs11': $1" ;;
            *)        [ -z "$lib" ] && lib=$1 || die "unexpected argument: $1" ;;
        esac
        shift
    done

    [ -n "$lib" ] || die "usage: sora provide pkcs11 <library> --box <box> --label <label>"
    [ -n "$box" ] || die "--box is required (which box has the driver?)"
    [ -n "$label" ] || die "--label is required (a short handle for this module)"
    case $label in (*[!A-Za-z0-9._-]*) die "label may only contain [A-Za-z0-9._-]" ;; esac
    # The single most likely mistake is tab-completing a HOST path, so the
    # message says whose filesystem this is.
    case $lib in
        /*) ;;
        *)  die "the library path must be absolute (it is a path INSIDE box '$box')" ;;
    esac
    case $lib in
        *[[:space:]]*)
            die "the library path may not contain whitespace; p11-kit cannot quote it" ;;
    esac

    need_cmd distrobox
    require_box "$box"
    container_exists "$box" || die "container '$box' does not exist"

    name=$(provide_name "$box" "$label")
    # 'sora-<box>-<label>' is ambiguous when both halves may contain '-', so
    # the collision is caught rather than designed away.
    row=$(provide_row "$name")
    if [ -n "$row" ]; then
        exbox=$(printf '%s' "$row" | cut -f3)
        exlabel=$(printf '%s' "$row" | cut -f4)
        if [ "$exbox" != "$box" ] || [ "$exlabel" != "$label" ]; then
            die "the name '$name' is already used by box '$exbox' label '$exlabel'; choose another --label"
        fi
        exlabel=$(printf '%s' "$row" | cut -f6)
        [ "$exlabel" = "$lib" ] ||
            warn "provision '$name' pointed at $exlabel; repointing it to $lib"
    fi

    ensure_libexec
    probe=$(distrobox enter --name "$box" -- \
        "$SORA_DATA/libexec/sora-pkcs11" check "$lib" 2>/dev/null) || probe=''
    pm=$(toml_get "$(box_meta "$box")" package_manager)
    case $probe in
        ok) ;;
        no-p11-kit|no-remote)
            warn "box '$box' cannot run 'p11-kit remote'; sora will not install anything for you"
            if hint=$(pkg_install_hint "$pm" p11-kit); then
                warn "run:  sora box enter $box -- $hint"
            else
                warn "install p11-kit (with 'remote' support) inside '$box'"
            fi
            die "'p11-kit remote' is required inside box '$box'" ;;
        no-lib) die "'$lib' does not exist inside box '$box'" ;;
        *) die "could not probe box '$box' for p11-kit" ;;
    esac

    # Nothing is written before every precondition passes.
    mkdir -p "$PKCS11_MODULES_DIR"
    file=$(pkcs11_module_file "$name")
    pkcs11_module_content "$name" "$box" "$lib" > "$file.tmp"
    chmod 0644 "$file.tmp"
    mv -f "$file.tmp" "$file"
    info "wrote $file"

    provide_write "$name" pkcs11 "$box" "$label" \
        "$([ "$want_nss" = 1 ] && printf nss || printf nonss)" "$lib"

    [ "$want_nss" = 1 ] && nss_register "$box"
    pkcs11_verify_host "$name"
    info "restart Chromium/Brave/Chrome for them to pick up the module"
    return 0
}

# Write one manifest into one destination, rewriting ONLY the path field.
#
# The verification is the point. Setting the rewritten file back to its old
# value has to reproduce the original byte for byte, which proves both that
# exactly one span moved and that that span held the old path - so a rewrite
# that targeted the wrong field cannot pass. allowed_origins binds the manifest
# to a browser extension's ID, and losing it is not a thing we can detect later.
nm_write_one() { # src dest-file new-path oldraw
    local jp tmp back
    jp="$SORA_DATA/libexec/sora-json-path"
    tmp="$2.sora-tmp"
    back="$2.sora-verify"
    if ! SORA_JP_VAL="$3" "$jp" set "$1" path > "$tmp" 2>/dev/null; then
        rm -f "$tmp"; return 1
    fi
    if ! SORA_JP_VAL="$4" "$jp" set "$tmp" path > "$back" 2>/dev/null ||
        ! cmp -s "$1" "$back"; then
        rm -f "$tmp" "$back"
        return 1
    fi
    rm -f "$back"
    cmp -s "$1" "$tmp" && { rm -f "$tmp"; return 1; }   # nothing changed
    chmod 0644 "$tmp"
    mv -f "$tmp" "$2"
}

cmd_provide_native_messaging() {
    local hostname='' box='' as_name='' browsers='' ext_ids='' wrapper name row jp
    local family path found=0 dir kind dest src oldraw newpath written=0
    local exbox exlabel other flat_hint='' shim app tmpdir
    while [ $# -gt 0 ]; do
        case $1 in
            --box|-b)   box=${2:?--box needs a value}; shift ;;
            --as)       as_name=${2:?--as needs a value}; shift ;;
            --browsers) browsers=${2:?--browsers needs a value}; shift ;;
            --extension-id)
                ext_ids="$ext_ids${2:?--extension-id needs a value}$TAB"; shift ;;
            -*)         die "unknown option for 'provide native-messaging': $1" ;;
            *)          [ -z "$hostname" ] && hostname=$1 || die "unexpected argument: $1" ;;
        esac
        shift
    done

    [ -n "$hostname" ] || die "usage: sora provide native-messaging <host-name> --box <box>"
    [ -n "$box" ] || die "--box is required (which box has the helper?)"
    # Chromium's own rule for a native messaging host name, and it also has to
    # be a safe filename: it becomes <host-name>.json.
    case $hostname in
        *[!a-z0-9_.]*) die "a native messaging host name may only contain [a-z0-9_.]" ;;
        .*|*.|*..*)    die "a native messaging host name may not start, end or double up on '.'" ;;
    esac

    need_cmd distrobox
    require_box "$box"
    container_exists "$box" || die "container '$box' does not exist"

    name=$(provide_name "$box" "$hostname")
    row=$(provide_row "$name")
    if [ -n "$row" ]; then
        exbox=$(printf '%s' "$row" | cut -f3)
        exlabel=$(printf '%s' "$row" | cut -f4)
        if [ "$exbox" != "$box" ] || [ "$exlabel" != "$hostname" ]; then
            die "the name '$name' is already used by box '$exbox' label '$exlabel'"
        fi
    fi
    # Two boxes providing the same host-name derive DIFFERENT registry names but
    # write the SAME <host-name>.json into the same profiles, so the second
    # would silently overwrite the first. provide_name cannot see this.
    other=$(awk -F'\t' -v l="$hostname" -v b="$box" \
        '$2 == "native-messaging" && $4 == l && $3 != b { print $3; exit }' \
        "$PROVIDE_REG" 2>/dev/null || true)
    [ -n "$other" ] &&
        die "box '$other' already provides '$hostname'; both write the same file into the same browser profiles"

    ensure_libexec
    jp="$SORA_DATA/libexec/sora-json-path"

    local scan
    scan=$(distrobox enter --name "$box" -- \
        "$SORA_DATA/libexec/sora-native-messaging" find "$hostname" 2>/dev/null) || scan=''
    if [ -z "$scan" ]; then
        warn "'$hostname' has no native messaging manifest inside box '$box'"
        distrobox enter --name "$box" -- \
            "$SORA_DATA/libexec/sora-native-messaging" list 2>/dev/null |
            while IFS=$TAB read -r _ n _; do
                [ -n "$n" ] && warn "  the box does provide: $n"
            done
        die "nothing to publish for '$hostname'"
    fi

    tmpdir=$(mktemp -d)
    local cm; cm=$(container_manager)
    while IFS=$TAB read -r family path; do
        [ -n "$family" ] || continue
        "$cm" cp "$box:$path" "$tmpdir/$family.json" 2>/dev/null ||
            die "could not copy $path out of box '$box'"
        # The name field has to match the filename, or no browser will load it.
        [ "$("$jp" get "$tmpdir/$family.json" name 2>/dev/null)" = "$hostname" ] ||
            die "the manifest in '$box' declares a different name than '$hostname'"
        oldraw=$("$jp" get-raw "$tmpdir/$family.json" path 2>/dev/null) ||
            die "the manifest in '$box' has no usable path field"
        found=1
    done <<EOF
$scan
EOF
    [ "$found" = 1 ] || die "nothing to publish for '$hostname'"

    src=$(printf '%s\n' "$scan" | head -n1 | cut -f2)
    local binpath
    binpath=$("$jp" get "$tmpdir/$(printf '%s\n' "$scan" | head -n1 | cut -f1).json" path) ||
        die "could not read the path field"
    # A box sharing the host's home can see sora's own output; publishing that
    # would point a wrapper at itself.
    case $binpath in
        "$EXPORT_PATH"/*)
            die "that manifest already points at $binpath, which is sora's own wrapper (a box sharing the host home sees it)" ;;
    esac

    wrapper=${as_name:-$(nm_wrapper_name "$hostname")}
    case $wrapper in
        *[!A-Za-z0-9._+-]*) die "the wrapper name '$wrapper' is not a valid command name; pass --as" ;;
    esac
    other=$(awk -F'\t' -v w="$wrapper" -v n="$name" -v t="$binpath" \
        '$2 == "native-messaging" && $5 == w && $1 != n && $6 != t { print $1; exit }' \
        "$PROVIDE_REG" 2>/dev/null || true)
    [ -n "$other" ] &&
        die "provision '$other' already uses the wrapper '$wrapper' for a different binary; pass --as"
    # The wrapper path is spliced into JSON without escaping, so it may not
    # contain anything that would need it.
    case "$EXPORT_PATH/$wrapper" in
        *[\"\\]*|*[[:cntrl:]]*) die "the path to $EXPORT_PATH contains a character that cannot go into JSON" ;;
    esac

    # Nothing has been written yet, so the export refusing to shadow a host
    # binary aborts cleanly. That refusal is deliberate here: a signing helper
    # has no business shadowing anything, so --force is not plumbed through.
    cmd_anxious --path "$binpath" --as "$wrapper" --box "$box"
    newpath="$EXPORT_PATH/$wrapper"

    # The row before the manifests, the opposite order from pkcs11 and for a
    # reason: a row with no files is recoverable with 'provide remove', while a
    # manifest with no row is not, because sora-<box>-<label> cannot be split
    # back apart when both halves may contain '-'.
    provide_write "$name" native-messaging "$box" "$hostname" "$wrapper" "$binpath"

    # --extension-id is the one operation that relaxes the byte-for-byte
    # guarantee: the file then differs from the box's by the path value AND by
    # the origins appended here. It is applied to the temp copy, once, before
    # any destination is written, so every destination still gets the same
    # bytes and the per-destination round-trip check still holds.
    if [ -n "$ext_ids" ]; then
        nm_add_extension_ids "$tmpdir" "$scan" "$ext_ids" || die "could not add the extension id(s)"
    fi

    while IFS=$TAB read -r family path; do
        [ -n "$family" ] || continue
        src="$tmpdir/$family.json"
        oldraw=$("$jp" get-raw "$src" path)
        while IFS=$TAB read -r kind dir; do
            [ -n "$dir" ] || continue
            [ -n "$browsers" ] && ! nm_browser_wanted "$dir" "$browsers" && continue
            # The directory outlives the Flatpak, so its existence is not
            # evidence that the app is there to read what we would write.
            if [ "$kind" = flatpak ]; then
                app=$(nm_flatpak_app "$dir") || continue
                if ! nm_flatpak_installed "$app"; then
                    info "skipping $app: the directory is left over, the Flatpak is not installed"
                    continue
                fi
            fi
            dest="$dir/$hostname.json"
            mkdir -p "$dir" 2>/dev/null || { warn "cannot create $dir"; continue; }
            if [ -f "$dest" ] && ! nm_is_ours "$dest" "$wrapper"; then
                nm_backup_foreign "$dest"
            fi
            if [ "$kind" = flatpak ]; then
                # A Flatpak browser execs the manifest's path INSIDE its
                # sandbox, where distrobox does not exist. It gets a shim in the
                # app's own config tree, which is readable there without any
                # filesystem grant.
                shim=$(nm_flatpak_shim "$dir" "$hostname") || continue
                mkdir -p "$(dirname "$shim")"
                printf '#!/bin/sh\n# Generated by sora. Removed by: sora provide remove %s\nexec flatpak-spawn --host %s "$@"\n' \
                    "$name" "$newpath" > "$shim"
                chmod 0755 "$shim"
                if nm_write_one "$src" "$dest" "$shim" "$oldraw"; then
                    written=$((written + 1))
                    app=$(nm_flatpak_app "$dir") &&
                        flat_hint="$flat_hint$app$TAB"
                else
                    warn "could not write $dest"
                fi
            elif nm_write_one "$src" "$dest" "$newpath" "$oldraw"; then
                written=$((written + 1))
                info "wrote $dest"
            else
                warn "could not write $dest"
            fi
        done <<EOF2
$(nm_manifest_dirs "$family")
EOF2
    done <<EOF
$scan
EOF
    rm -rf "$tmpdir"

    if [ "$written" = 0 ]; then
        provide_write "$name" '' '' '' '' ''
        anxious_remove "$wrapper" >/dev/null 2>&1 || true
        die "no browser profile could be written; nothing was left behind"
    fi

    info "published '$hostname' from '$box' into $written browser profile(s) via $newpath"
    if [ -n "$flat_hint" ]; then
        printf '%s' "$flat_hint" | tr "$TAB" '\n' | sort -u | while read -r app; do
            [ -n "$app" ] || continue
            info "for the Flatpak browser $app, run:"
            info "  flatpak override --user --talk-name=org.freedesktop.Flatpak $app"
        done
    fi
    info "restart the browser for it to pick up the manifest"
    return 0
}

# --browsers takes profile keys ('brave', 'firefox', 'chromium'); a directory
# matches when its path contains one, case-insensitively (Brave's directory is
# capitalised, nobody types it that way).
nm_browser_wanted() { # dir list -> 0 if this directory should be written
    local want lower
    lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    local IFS=','
    for want in $2; do
        [ -n "$want" ] || continue
        want=$(printf '%s' "$want" | tr '[:upper:]' '[:lower:]')
        case $lower in *"$want"*) return 0 ;; esac
    done
    return 1
}

# The two families name the same thing differently: Chromium wants a full
# chrome-extension:// origin and Firefox wants the bare extension id, so the
# user gives the id once and each manifest gets the right shape.
# An extension id belongs to exactly one browser family: Chromium ids are 32
# letters in a-p, Firefox ids are {uuid} or name@domain. So each id is routed
# to the family whose shape it has, rather than being forced into both - the
# same id cannot be valid for both, and demanding one per family would be
# asking the user to know something they already told us by its format.
nm_add_extension_ids() { # tmpdir scan ids
    local jp id bare kind family key item tmp used
    jp="$SORA_DATA/libexec/sora-json-path"
    local IFS=$TAB
    for id in $3; do
        [ -n "$id" ] || continue
        bare=${id#chrome-extension://}; bare=${bare%/}
        kind=''
        case $bare in
            *[!a-p]*) ;;
            *) [ ${#bare} = 32 ] && kind=chromium ;;
        esac
        if [ -z "$kind" ]; then
            case $id in
                \{*\}|*@*) kind=firefox; bare=$id ;;
                *) die "'$id' is neither a Chromium extension id (32 characters, a-p) nor a Firefox one ({uuid} or name@domain)" ;;
            esac
        fi
        if [ "$kind" = chromium ]; then
            key=allowed_origins; item="chrome-extension://$bare/"
        else
            key=allowed_extensions; item=$bare
        fi
        used=0
        for family in chromium firefox; do
            [ "$family" = "$kind" ] || continue
            [ -f "$1/$family.json" ] || continue
            tmp="$1/$family.json.tmp"
            if SORA_JP_VAL="$item" "$jp" array-add "$1/$family.json" "$key" > "$tmp" 2>/dev/null; then
                mv -f "$tmp" "$1/$family.json"
                info "added $item to $key"
                used=1
            else
                rm -f "$tmp"
                die "the $family manifest has no '$key' array to add '$item' to"
            fi
        done
        [ "$used" = 1 ] ||
            warn "'$id' is a $kind extension id, but '$hostname' ships no $kind manifest; ignored"
    done
    return 0
}

nm_backup_foreign() { # file
    local dest
    dest="$SORA_CACHE/native-messaging"
    mkdir -p "$dest"
    dest="$dest/${1##*/}.$(date -u +%Y%m%dT%H%M%SZ)"
    cp -f "$1" "$dest" 2>/dev/null || return 1
    warn "a manifest that sora did not write was already at $1"
    warn "backed it up to $dest; 'provide remove' will NOT restore it"
}

cmd_provide() {
    local sub=${1:-}
    [ -n "$sub" ] && shift || true
    case $sub in
        pkcs11)             cmd_provide_pkcs11 "$@" ;;
        native-messaging)   cmd_provide_native_messaging "$@" ;;
        list|--list|-l)     provide_list ;;
        remove|--remove|-r) cmd_provide_remove "$@" ;;
        *) die "usage: sora provide <pkcs11 <library> --box <box> --label <label>|native-messaging <host-name> --box <box>|list|remove <name>>" ;;
    esac
}

# ---------------------------------------------------------------------------
# sora completion — live delegation (strategy B)
#
# Everything else completes from data copied out of a box ahead of time.
# Delegation instead asks the running box, on every Tab, what it would offer.
# That is the only way to see candidates computed from the box's live state
# (running units, installed images, the actual database), and it costs a
# container round-trip every time, so it is opt-in per command.
# ---------------------------------------------------------------------------

delegate_write() { # cmd box  (empty box removes)
    mkdir -p "$SORA_CONFIG"
    touch "$DELEGATE_REG"
    awk -F'\t' -v c="$1" '$1 != c' "$DELEGATE_REG" > "$DELEGATE_REG.tmp"
    [ -n "$2" ] && printf '%s\t%s\n' "$1" "$2" >> "$DELEGATE_REG.tmp"
    mv "$DELEGATE_REG.tmp" "$DELEGATE_REG"
}

cmd_completion() {
    local sub=${1:-} cmd='' box=''
    [ -n "$sub" ] && shift || true
    case $sub in
        delegate)
            while [ $# -gt 0 ]; do
                case $1 in
                    --box|-b) box=${2:?--box needs a value}; shift ;;
                    -*)       die "unknown option for 'completion delegate': $1" ;;
                    *)        [ -z "$cmd" ] && cmd=$1 || die "unexpected argument: $1" ;;
                esac
                shift
            done
            [ -n "$cmd" ] || die "usage: sora completion delegate <command> --box <box>"
            [ -n "$box" ] || die "--box is required (which box should answer the Tab?)"
            case $cmd in (*[!A-Za-z0-9._+-]*) die "command name may only contain [A-Za-z0-9._+-]" ;; esac
            container_exists "$box" || die "container '$box' does not exist"
            ensure_libexec
            delegate_write "$cmd" "$box"
            info "'$cmd' will complete live from box '$box'"
            info "every Tab enters the container (~300ms); Tabs are skipped while it is stopped"
            info "open a new shell to activate"
            ;;
        list|--list|-l)
            if [ -s "$DELEGATE_REG" ]; then
                printf '%-24s %-16s %s\n' COMMAND BOX STATUS
                while IFS=$TAB read -r cmd box; do
                    [ -n "$cmd" ] || continue
                    if container_running "$box"; then
                        printf '%-24s %-16s %s\n' "$cmd" "$box" "running"
                    elif container_exists "$box"; then
                        printf '%-24s %-16s %s\n' "$cmd" "$box" "stopped (Tabs skipped)"
                    else
                        printf '%-24s %-16s %s\n' "$cmd" "$box" "MISSING"
                    fi
                done < "$DELEGATE_REG"
            else
                info "no commands delegated - try: sora completion delegate <cmd> --box <box>"
            fi
            ;;
        remove|--remove|-r)
            cmd=${1:?usage: sora completion remove <command>}
            [ -f "$DELEGATE_REG" ] && grep -q "^$cmd$TAB" "$DELEGATE_REG" ||
                die "'$cmd' is not delegated"
            delegate_write "$cmd" ""
            info "'$cmd' no longer completes live (open a new shell)"
            ;;
        status)
            local n=0 k
            [ -s "$DELEGATE_REG" ] && n=$(grep -c . "$DELEGATE_REG")
            printf 'synced from boxes (strategy A):\n'
            for k in bash zsh fish; do
                printf '  %-5s %s scripts (%s)\n' "$k" \
                    "$(count_files "$SORA_DATA/completions/$k")" \
                    "$SORA_DATA/completions/$k"
            done
            printf 'generated by the tool itself (strategy C): use %s\n' "'sora anxious --with-completion'"
            printf 'delegated live (strategy B): %s command(s)\n' "$n"
            ;;
        *)
            die "usage: sora completion <delegate <cmd> --box <box>|list|remove <cmd>|status>"
            ;;
    esac
}

# Hidden: called by bash as 'complete -C "sora _complete <box>" <cmd>'.
# bash hands the line over through COMP_LINE/COMP_POINT in the environment and
# turns every line we print into a candidate.
cmd_complete_hidden() {
    local box=${1:-}
    [ -n "$box" ] || return 0
    [ -n "${COMP_LINE:-}" ] || return 0
    # A stopped box yields nothing rather than a 3-second freeze.
    container_running "$box" || return 0
    local capture="$SORA_DATA/libexec/sora-capture-bash"
    [ -x "$capture" ] || return 0
    distrobox enter --name "$box" -- "$capture" \
        "$COMP_LINE" "${COMP_POINT:-${#COMP_LINE}}" 2>/dev/null
}

# ---------------------------------------------------------------------------
# sora hook — shell hook installation
# ---------------------------------------------------------------------------

hook_file() { # bash|zsh|fish
    printf '%s\n' "$SORA_SHARE/shell/hook.$1"
}

hook_rc_target() { # bash|zsh|fish
    case $1 in
        bash) printf '%s\n' "$HOME/.bashrc" ;;
        zsh)  printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" ;;
        fish) printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/zz-sora.fish" ;;
    esac
}

# System-wide hook installs are the NORMAL case on a distro that packages
# sora (e.g. an OS image dropping /etc/profile.d/zz-sora.sh for every user).
# Detection must see them, or every user of such a distro gets told to
# 'sora hook install' a hook that is already active — adding a redundant rc
# line — while doctor cries wolf about a missing hook.
# SORA_SYSROOT exists for the test suite; it is empty in real use.
hook_system_file() { # bash|zsh|fish -> prints the system file, if any
    local root="${SORA_SYSROOT:-}" f
    local candidates=()
    case $1 in
        bash) candidates=("$root"/etc/profile.d/*sora*.sh) ;;
        zsh)  candidates=("$root"/etc/profile.d/*sora*.zsh "$root"/etc/zshrc.d/*sora*) ;;
        fish) candidates=("$root"/usr/share/fish/vendor_conf.d/*sora*.fish
                          "$root"/etc/fish/conf.d/*sora*.fish) ;;
    esac
    for f in "${candidates[@]}"; do
        [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
    return 1
}

hook_installed() { # bash|zsh|fish
    # Detection greps for the marker COMMENT, never for the hook's path: the
    # path only contains "sora" when the checkout/prefix happens to be named
    # that way, and a path-based check made repeated installs append
    # duplicate lines from neutrally-named checkouts.
    local rc
    rc=$(hook_rc_target "$1")
    case $1 in
        fish) [ -f "$rc" ] ;;
        *)    grep -qs 'sora: resolve distrobox commands' "$rc" ;;
    esac
}

hook_install_one() { # bash|zsh|fish
    local shell=$1 rc file tmp sysf
    if sysf=$(hook_system_file "$shell"); then
        info "$shell: system-wide hook already active ($sysf); nothing to install"
        return 0
    fi
    rc=$(hook_rc_target "$shell")
    file=$(hook_file "$shell")
    if [ "$shell" = fish ]; then
        # A file we own: rewriting is naturally idempotent AND self-repairing.
        mkdir -p "$(dirname "$rc")"
        printf '# sora: late resolution of distrobox commands\nsource "%s"\n' "$file" > "$rc"
        info "$shell: hook installed in $rc (open a new shell to activate)"
        return 0
    fi
    if hook_installed "$shell"; then
        if grep -qsF "$file" "$rc"; then
            info "$shell: already installed ($rc)"
            return 0
        fi
        # Repair: the rc references a hook path from a different install —
        # typically a versioned Homebrew keg that an upgrade removed, which
        # would kill the hook silently. Drop the old block and re-append.
        tmp=$(mktemp)
        grep -v -e 'sora: resolve distrobox commands' \
                -e 'Keep this near the END of the file so sora' \
                -e 'sora/shell/hook\.' "$rc" > "$tmp"
        mv "$tmp" "$rc"
        info "$shell: refreshing stale hook path in $rc"
    fi
    {
        printf '\n# sora: resolve distrobox commands on command-not-found.\n'
        printf '# Keep this near the END of the file so sora can chain to other handlers.\n'
        printf '[ -f "%s" ] && . "%s"\n' "$file" "$file"
    } >> "$rc"
    info "$shell: hook installed in $rc (open a new shell to activate)"
}

cmd_hook() {
    local sub=${1:-} shell
    [ -n "$sub" ] && shift || true
    case $sub in
        print)
            shell=${1:?usage: sora hook print <bash|zsh|fish>}
            case $shell in bash|zsh|fish) ;; *) die "unknown shell '$shell'" ;; esac
            printf 'source "%s"\n' "$(hook_file "$shell")"
            ;;
        install)
            local shells=()
            if [ $# -gt 0 ]; then
                for shell in "$@"; do
                    case $shell in bash|zsh|fish) shells+=("$shell") ;; *) die "unknown shell '$shell'" ;; esac
                done
            else
                # Default: every shell present on the host.
                command -v bash >/dev/null 2>&1 && shells+=(bash)
                command -v zsh  >/dev/null 2>&1 && shells+=(zsh)
                command -v fish >/dev/null 2>&1 && shells+=(fish)
            fi
            for shell in "${shells[@]}"; do
                hook_install_one "$shell"
            done
            ;;
        status)
            local sysf
            for shell in bash zsh fish; do
                if sysf=$(hook_system_file "$shell"); then
                    printf '%-5s installed  (system-wide: %s)\n' "$shell" "$sysf"
                elif hook_installed "$shell"; then
                    printf '%-5s installed  (%s)\n' "$shell" "$(hook_rc_target "$shell")"
                else
                    printf '%-5s not installed\n' "$shell"
                fi
            done
            ;;
        *)
            die "usage: sora hook <install [shells...]|status|print <shell>>"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# sora doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
    local problems=0 meta name shell
    ok()  { printf '  ok   %s\n' "$*"; }
    bad() { printf '  FAIL %s\n' "$*"; problems=$((problems + 1)); }

    printf 'sora doctor:\n'
    command -v distrobox >/dev/null 2>&1 && ok "distrobox found" || bad "distrobox not found"
    if command -v podman >/dev/null 2>&1 || command -v docker >/dev/null 2>&1; then
        ok "container manager found ($(container_manager))"
    else
        bad "no container manager (podman/docker)"
    fi
    command -v awk >/dev/null 2>&1 && ok "awk found" || bad "awk not found (the shell hook needs it)"
    command -v xdg-user-dir >/dev/null 2>&1 && ok "xdg-user-dir found" ||
        bad "xdg-user-dir not found (XDG folder symlinks unavailable)"

    if [ -s "$INDEX" ]; then
        ok "index present: $(wc -l < "$INDEX") commands ($INDEX)"
    else
        bad "index missing or empty - run 'sora reindex'"
    fi

    if [ -d "$BOXES_DIR" ]; then
        for meta in "$BOXES_DIR"/*.toml; do
            [ -f "$meta" ] || break
            name=${meta##*/}; name=${name%.toml}
            if container_exists "$name"; then
                ok "box '$name': container present"
            else
                bad "box '$name': container MISSING (run 'sora box rm $name' or recreate it)"
            fi
        done
    fi

    local rc hookpath sysf
    for shell in bash zsh fish; do
        command -v "$shell" >/dev/null 2>&1 || continue
        if sysf=$(hook_system_file "$shell"); then
            ok "$shell hook active system-wide ($sysf)"
            continue
        fi
        if ! hook_installed "$shell"; then
            bad "$shell hook not installed (run 'sora hook install $shell')"
            continue
        fi
        # Installed is not enough: the rc line must point at a file that
        # still exists (a removed Homebrew keg kills the hook silently).
        rc=$(hook_rc_target "$shell")
        case $shell in
            fish) hookpath=$(sed -n 's/^source "\(.*\)"$/\1/p' "$rc" | tail -1) ;;
            *)    hookpath=$(sed -n 's/^\[ -f "\(.*\)" \] && .*/\1/p' "$rc" |
                      grep "sora/shell/hook\.$shell" | tail -1) ;;
        esac
        if [ -n "$hookpath" ] && [ ! -f "$hookpath" ]; then
            bad "$shell hook points at a missing file ($hookpath) - run 'sora hook install $shell' to repair"
        else
            ok "$shell hook installed"
        fi
    done

    # Broken PATH entries defeat late resolution: the shell "finds" the
    # corpse, fails with ENOENT, and the command-not-found hook never fires.
    if [ -s "$INDEX" ]; then
        local dir entry name found_dangling=0
        local IFS=':'
        for dir in $PATH; do
            unset IFS
            [ -d "$dir" ] || continue
            for entry in "$dir"/*; do
                [ -L "$entry" ] && [ ! -e "$entry" ] || continue
                name=${entry##*/}
                if awk -F'\t' -v c="$name" '$1 == c { f = 1; exit } END { exit !f }' "$INDEX"; then
                    bad "dangling symlink $entry shadows indexed command '$name' (remove it so the hook can fire)"
                    found_dangling=1
                fi
            done
        done
        unset IFS
        [ "$found_dangling" = 0 ] && ok "no dangling PATH entries shadow indexed commands"
    fi

    case ":$PATH:" in
        *":$EXPORT_PATH:"*) ok "$EXPORT_PATH is in PATH (anxious exports will resolve)" ;;
        *) bad "$EXPORT_PATH is NOT in PATH (anxious exports will not resolve)" ;;
    esac

    # Only when something is provided: a host with no provisions should see
    # nothing new here. Note what doctor deliberately does NOT do: run
    # 'p11-kit list-modules'. That loads every module, a driver is allowed to
    # abort the process doing it, and doctor is the command people run when
    # things are already broken.
    if [ -s "$PROVIDE_REG" ]; then
        local pname pkind pbox plabel pdetail ptarget pfile dbx wants_nss=0 f
        # Gated on there actually being a pkcs11 row: a host that only ever
        # used another adapter has no reason to install p11-kit, and telling it
        # otherwise is crying wolf on the command people run when something is
        # already wrong.
        if [ "$(provide_count_kind pkcs11)" != 0 ]; then
            nss_proxy_lib >/dev/null 2>&1 ||
                bad "p11-kit is not installed on the host; the files in $PKCS11_MODULES_DIR are read by nothing"
        fi
        # Column 5 is a per-kind detail and column 2 says how to read it, so
        # the kind has to be dispatched on rather than discarded. Reading every
        # row as pkcs11 reported perfectly good provisions of another kind as
        # broken, and advised a 'remove' that would have destroyed them.
        while IFS=$TAB read -r pname pkind pbox plabel pdetail ptarget; do
            [ -n "$pname" ] || continue
            container_exists "$pbox" ||
                bad "provision '$pname' targets box '$pbox', whose container is MISSING"
            case $pkind in
                pkcs11)
                    [ "$pdetail" = nss ] && wants_nss=1
                    pfile=$(pkcs11_module_file "$pname")
                    if [ ! -f "$pfile" ]; then
                        bad "provision '$pname' has no module file; run 'sora provide remove $pname'"
                        continue
                    fi
                    # The absolute distrobox path is pinned inside the file, so
                    # a Homebrew upgrade that moves it breaks the module
                    # silently. The registry carries every argument needed to
                    # print the fix.
                    dbx=$(sed -n 's/^remote: |\([^ ]*\) .*/\1/p' "$pfile")
                    [ -n "$dbx" ] && [ ! -x "$dbx" ] &&
                        bad "provision '$pname' points at a missing distrobox ($dbx); re-run: sora provide pkcs11 $ptarget --box $pbox --label $plabel"
                    ;;
                native-messaging)
                    if [ ! -x "$EXPORT_PATH/$pdetail" ]; then
                        bad "provision '$pname' has no wrapper at $EXPORT_PATH/$pdetail; the browsers point at a missing file"
                    elif [ "$(nm_count_installed "$plabel" "$pdetail")" = 0 ]; then
                        bad "provision '$pname' has no manifest in any browser profile; re-run: sora provide native-messaging $plabel --box $pbox"
                    fi
                    # The exported wrapper runs 'distrobox-enter' by bare name,
                    # so a distrobox outside the session PATH (Homebrew, or
                    # ~/.local) breaks it silently: the extension simply reports
                    # the host as not installed.
                    PATH=/usr/bin:/bin command -v distrobox-enter >/dev/null 2>&1 ||
                        bad "distrobox-enter is not on a login PATH; browser-launched wrappers for '$pname' will fail silently"
                    ;;
                *)  bad "provision '$pname' has an unknown kind '$pkind'; this sora is older than the provision" ;;
            esac
        done < "$PROVIDE_REG"
        for f in "$PKCS11_MODULES_DIR"/sora-*.module; do
            [ -f "$f" ] || continue
            pname=${f##*/}; pname=${pname%.module}
            [ -n "$(provide_row "$pname")" ] ||
                bad "orphan module file $f; 'sora provide remove $pname' will take it"
        done
        if [ "$wants_nss" = 1 ]; then
            local ndb=0 nok=0 d
            while IFS= read -r d; do
                [ -n "$d" ] || continue
                ndb=$((ndb + 1))
                [ "$(nss_state "$d")" = absent ] || nok=$((nok + 1))
            done <<EOF
$(nss_databases)
EOF
            if [ "$nok" = 0 ]; then
                bad "there are pkcs11 provisions but no NSS database has a p11-kit proxy; no browser will see them"
            elif [ "$nok" -lt "$ndb" ]; then
                # A Firefox profile created after the provision is normal and
                # is not a fault: say what to run, do not cry wolf.
                ok "the proxy is in $nok of $ndb NSS database(s); re-run 'sora provide pkcs11' to cover the rest"
            else
                ok "the proxy is registered in all $ndb NSS database(s)"
            fi
        fi
    fi

    if [ "$problems" = 0 ]; then
        info "all checks passed"
    else
        die "$problems problem(s) found"
    fi
}

# ---------------------------------------------------------------------------
# Hidden template inspection (used by the test suite; content generation is
# where quoting bugs hide, so the tests assert on GENERATED content)
# ---------------------------------------------------------------------------

cmd_template() {
    local what=${1:?usage: sora _template <dnf5|apt|pacman|trigger|reindex|inbox-install|detect-pm|which|capture-bash|desktop-scan|pkcs11|json-path|native-messaging> [arg]}
    case $what in
        dnf5|apt|pacman) template_pm_hook "$what" ;;
        trigger)         template_trigger "${2:?_template trigger needs a box name}" ;;
        reindex)         template_reindex ;;
        inbox-install)   template_inbox_install "${2:?_template inbox-install needs a pm type}" ;;
        detect-pm)       template_detect_pm ;;
        which)           template_which ;;
        capture-bash)    template_capture_bash ;;
        desktop-scan)    template_desktop_scan ;;
        pkcs11)          template_pkcs11 ;;
        json-path)       template_json_path ;;
        native-messaging) template_native_messaging ;;
        *) die "unknown template '$what'" ;;
    esac
}

cmd_template_path() {
    pm_hook_path "${1:?usage: sora _template-path <dnf5|apt|pacman>}"
}

# ---------------------------------------------------------------------------
# Help / dispatch
# ---------------------------------------------------------------------------

usage() {
    cat <<'EOF'
sora — distrobox commands as if they were native host commands

Boxes
  sora box create <name> --image <image|alias> [--priority N]
                  [--pkg-manager PM] [--no-own-home] [--no-xdg-links]
                  [--hide PATH]... [--additional-flags FLAGS]... [--nvidia]
                                   --additional-flags reaches the container
                                   manager (devices, volumes, CDI); --nvidia is
                                   distrobox's own, and is what injects the
                                   host driver
  sora box list
  sora box enter <name>
  sora box rm <name> [--yes] [--delete-home]
  sora box set-priority <name> <N>
  sora images                      show the image alias catalog

Index (late resolution)
  sora reindex [box...]            rebuild the command->box index (alias: sync)
  sora conflicts                   commands present in more than one box
  sora pin <command> <box>         force a command to resolve to one box
  sora pin --list | --remove <command>
  sora which <command>             how a command would resolve (host vs box)

Eager export
  sora anxious [--sudo] [--with-completion] <command> --box <box>
                                   --with-completion also installs the tool's
                                   own shell completion (cobra/clap/click)
  sora anxious --path <abs-path-in-box> --as <name> --box <box>
                                   export a binary that is NOT in the box's
                                   PATH (e.g. /opt/vendor/tool), under a name
                                   you choose
                                   an export that would shadow a host binary
                                   is refused; --as renames it, --force
                                   shadows it deliberately
  sora anxious --list
  sora anxious --remove <command>

Desktop entry (GUI apps: browsers, editors, anything with a window)
  sora anxious --desktop <command> --box <box>
                                   export the wrapper AND write a .desktop
                                   entry, asking for the fields it cannot
                                   read off the box. Icons are extracted from
                                   the box in every size available.
  Every question is also a flag, so it scripts:
    --name, --generic-name, --comment, --icon, --categories, --mime,
    --keywords, --wmclass, --terminal, --browser, --default-browser,
    --detect-wmclass, --no-prompt
  --browser fills MimeType/Categories for a web browser and offers to make
  it the host's default handler for http/https.

Publish a box resource to the host
  sora provide pkcs11 <library> --box <box> --label <label> [--no-nss]
                                   a PKCS#11 token driver that lives in a box,
                                   usable by the host's browsers. Writes a
                                   p11-kit module file and registers the host's
                                   p11-kit-proxy.so in ~/.pki/nssdb and in every
                                   Firefox profile (Firefox keeps one NSS
                                   database per profile; Chromium shares one).
                                   A Flatpak browser gets p11-kit-client.so
                                   instead, and the two commands it needs are
                                   printed, never run.
  sora provide native-messaging <host-name> --box <box> [--as <name>]
                                   [--browsers <list>] [--extension-id <id>]...
                                   a browser signing helper that lives in a
                                   box, usable by the host's browsers. Copies
                                   the manifest out and repoints it at an
                                   exported wrapper.
  sora provide list
  sora provide remove <name>

Tab completion
  sora completion status           what is wired up, per strategy
  sora completion delegate <command> --box <box>
                                   opt in to LIVE completion for one command:
                                   every Tab asks the running box (~300ms)
  sora completion list | remove <command>
  (box completion scripts are synced automatically by 'sora reindex')

Shell integration
  sora hook install [bash zsh fish]   install the command-not-found hook
  sora hook status
  sora hook print <shell>

Maintenance
  sora doctor                      sanity-check the whole setup
  sora version
EOF
}

main() {
    local cmd=${1:-}
    [ -n "$cmd" ] && shift || { usage; exit 64; }
    case $cmd in
        box)             cmd_box "$@" ;;
        images)          cmd_images "$@" ;;
        reindex|sync)    cmd_reindex "$@" ;;
        conflicts)       cmd_conflicts "$@" ;;
        pin)             cmd_pin "$@" ;;
        which)           cmd_which "$@" ;;
        anxious)         cmd_anxious "$@" ;;
        provide)         cmd_provide "$@" ;;
        completion)      cmd_completion "$@" ;;
        hook)            cmd_hook "$@" ;;
        doctor)          cmd_doctor "$@" ;;
        _complete)       cmd_complete_hidden "$@" ;;
        _template)       cmd_template "$@" ;;
        _template-path)  cmd_template_path "$@" ;;
        version|--version|-V) printf 'sora %s\n' "$SORA_VERSION" ;;
        help|--help|-h)  usage ;;
        *) printf 'sora: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 64 ;;
    esac
}

main "$@"
