# AUR PKGBUILD for sora ("sora" is unclaimed on AUR as of 2026-08).
# Maintainer: TODO <todo@example.com>
pkgname=sora
pkgver=0.1.0
pkgrel=1
pkgdesc="Distrobox commands as if they were native host commands"
arch=('any')
url="https://github.com/REPLACE_ME/sora"
license=('MIT')
depends=('bash' 'distrobox' 'awk')
optdepends=('podman: rootless container manager (recommended)'
            'docker: alternative container manager'
            'xdg-user-dirs: XDG folder symlinks in box homes')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')  # TODO: pin on first release

check() {
  cd "$pkgname-$pkgver"
  bash tests/run.sh
}

package() {
  cd "$pkgname-$pkgver"
  make install PREFIX=/usr DESTDIR="$pkgdir"
  install -D -m 0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
